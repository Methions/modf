		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -18, .5, 0), Size = UDim2.fromOffset(96, 30),
		BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0, Text = "Unpin all", TextColor3 = Theme.Muted, TextSize = 12,
