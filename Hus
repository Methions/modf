	--------------------------------------------------------------------
	-- state
	--------------------------------------------------------------------
	local api = { Root = root, Gui = gui, Closed = false, _destroyed = false, _listeners = {} }
	local rows, chipRefs = {}, {}
	local kindFilter = "All"
	local listenersRemoved = false

	local function items() return win._quickItems or {} end
	local function currentPinned(meta)
		local f = win._quickFloats and win._quickFloats[meta]
		return f ~= nil and not f.Closed and not f._destroyed
	end
	local function updateCount()
		local count, total = 0, 0
		for _, meta in ipairs(items()) do
			if meta.Object and not meta.Object._destroyed then
				total += 1
				if currentPinned(meta) then count += 1 end
			end
		end
		countPillText.Text = count .. " pinned"
		footerText.Text = string.format("%d of %d controls pinned", count, total)
		tween(unpinAll, { TextColor3 = count > 0 and Theme.Text or Theme.Muted }, .2)
	end

	local function createTile(meta, order)
		local spec = QUICK_KINDS[meta.Kind] or QUICK_KINDS.Button
		local cell = new("Frame", { BackgroundTransparency = 1, LayoutOrder = order, Parent = list })
		local tile = new("CanvasGroup", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0, GroupTransparency = 1, Parent = cell,
		})
		corner(tile, UDim.new(0, 18))
		local sc = new("UIScale", { Scale = .8, Parent = tile })
		local blob = new("Frame", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(30, 30), Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 1, Parent = tile,
		})
		corner(blob, UDim.new(1, 0))
		local chip = new("Frame", {
			Position = UDim2.fromOffset(13, 13), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = Theme.Surface3,
			BorderSizePixel = 0, ZIndex = 2, Parent = tile,
		})
		corner(chip, UDim.new(1, 0))
		local chipScale = new("UIScale", { Parent = chip })
		local chipIcon = quickIcon(chip, spec.Icon, spec.Fallback, 17, Theme.Accent)
		local name = mkText {
			Position = UDim2.fromOffset(14, 55), Size = UDim2.new(1, -28, 0, 18), Text = meta.Name, TextSize = 13, ZIndex = 3, Parent = tile,
		}
		local tag = mkText {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 21), Size = UDim2.fromOffset(100, 14),
			Text = spec.Label, TextSize = 10, TextColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.None, ZIndex = 3, Parent = tile,
		}
		local hitBtn = new("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = tile,
		})

		local function update(animate)
			local pinned = currentPinned(meta)
			local t = animate and .35 or 0
			name.Text = meta.Name
			tween(blob, { Size = pinned and UDim2.fromOffset(520, 520) or UDim2.fromOffset(0, 0) },
				animate and (pinned and .85 or .55) or 0, LIQUID)
			tween(name, { TextColor3 = pinned and Theme.AccentDark or Theme.Text }, t)
			tween(tag, { TextColor3 = pinned and Theme.AccentDark or Theme.Muted }, t)
			tag.Text = pinned and "PINNED" or spec.Label
			tween(chip, { BackgroundColor3 = pinned and Theme.AccentDark or Theme.Surface3 }, t)
			chipIcon.Color(Theme.Accent, t)
		end
		rows[meta] = { Cell = cell, Update = update }

		hitBtn.MouseEnter:Connect(function() tween(sc, { Scale = 1.035 }, .45, SPRING) end)
		hitBtn.MouseLeave:Connect(function() tween(sc, { Scale = 1 }, .45, SPRING) end)
		hitBtn.MouseButton1Down:Connect(function() tween(sc, { Scale = .94 }, .1) end)
		hitBtn.MouseButton1Up:Connect(function() tween(sc, { Scale = 1.03 }, .5, SPRING) end)
		hitBtn.MouseButton1Click:Connect(function()
			if api.Closed or api._destroyed then return end
			local existing = win._quickFloats and win._quickFloats[meta]
			if existing and not existing.Closed then
				existing.Close()
			else
				createQuickShortcut(win, meta)
			end
			chipScale.Scale = 1.3
			tween(chipScale, { Scale = 1 }, .6, SPRING)
			update(true)
			updateCount()
		end)

		update(false)
		-- staggered liquid pop-in
		task.delay(.12 + math.min(order, 10) * .04, function()
			if not tile.Parent then return end
			tween(sc, { Scale = 1 }, .6, SPRING)
			tween(tile, { GroupTransparency = 0 }, .3)
		end)
	end

	local function styleChips(instant)
		local t = instant and 0 or .25
		for k, b in pairs(chipRefs) do
			local on = kindFilter == k
			tween(b, { BackgroundColor3 = on and Theme.Accent or Theme.Surface2, TextColor3 = on and Theme.AccentDark or Theme.Muted }, t, LIQUID)
		end
	end

	local function applyFilter()
		local q = string.lower(searchBox.Text or "")
		local shown, total = 0, 0
		for _, meta in ipairs(items()) do
			local row = rows[meta]
			if row then
				total += 1
				local text = string.lower(meta.Name .. " " .. meta.Kind .. " " .. meta.Desc)
				local match = (q == "" or string.find(text, q, 1, true) ~= nil) and (kindFilter == "All" or meta.Kind == kindFilter)
				row.Cell.Visible = match
				if match then shown += 1 end
			end
		end
		empty.Text = total == 0 and "Nothing to pin yet.\nButtons, toggles, keybinds, sliders and more will show up here."
			or "No controls match."
		empty.Visible = shown == 0
	end

	local function buildChips()
		for _, b in pairs(chipRefs) do if b.Parent then b:Destroy() end end
		table.clear(chipRefs)
		local present = {}
		for _, meta in ipairs(items()) do
			if meta.Object and not meta.Object._destroyed then present[meta.Kind] = true end
		end
		local kinds = { "All" }
		for _, k in ipairs(QUICK_ORDER) do if present[k] then table.insert(kinds, k) end end
		if kindFilter ~= "All" and not present[kindFilter] then kindFilter = "All" end
		for i, k in ipairs(kinds) do
			local b = new("TextButton", {
				Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Surface2,
				BorderSizePixel = 0, Text = k == "All" and "All" or QUICK_PLURAL[k], TextSize = 12, FontFace = Fonts.Medium,
				TextColor3 = Theme.Muted, AutoButtonColor = false, LayoutOrder = i, ZIndex = 5, Parent = chipRow,
			})
			corner(b, UDim.new(1, 0))
			pad(b, 14, 14)
			local s = new("UIScale", { Parent = b })
			b.MouseButton1Down:Connect(function() tween(s, { Scale = .92 }, .1) end)
			b.MouseButton1Up:Connect(function() tween(s, { Scale = 1 }, .5, SPRING) end)
			b.MouseLeave:Connect(function() tween(s, { Scale = 1 }, .4, SPRING) end)
			b.MouseButton1Click:Connect(function()
				kindFilter = k
				styleChips()
				applyFilter()
			end)
			chipRefs[k] = b
		end
		styleChips(true)
	end

	local function rebuild()
		for _, row in pairs(rows) do if row.Cell.Parent then row.Cell:Destroy() end end
		table.clear(rows)
		local order = 0
		for _, meta in ipairs(items()) do
			if meta.Object and not meta.Object._destroyed then
				order += 1
				createTile(meta, order)
				meta._pickerRefresh = function()
					local row = rows[meta]
					if row then row.Update(true) end
					updateCount()
				end
				meta._pickerRemove = function()
					local row = rows[meta]
					if row and row.Cell.Parent then row.Cell:Destroy() end
					rows[meta] = nil
					buildChips()
					applyFilter()
					updateCount()
				end
			end
		end
		buildChips()
		applyFilter()
		updateCount()
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)
	unpinAll.MouseButton1Click:Connect(function()
		local n = 0
		for _, meta in ipairs(items()) do
			local f = win._quickFloats and win._quickFloats[meta]
			if f and not f.Closed then
				n += 1
				task.delay(n * .05, function() if not f.Closed then f.Close() end end)
			end
		end
	end)

	--------------------------------------------------------------------
	-- lifecycle
	--------------------------------------------------------------------
	local function removeListeners()
		if listenersRemoved then return end
		listenersRemoved = true
		for _, remove in ipairs(api._listeners) do pcall(remove) end
		api._listeners = {}
		if api._escapeConnection then api._escapeConnection:Disconnect() api._escapeConnection = nil end
		for _, meta in ipairs(items()) do
			meta._pickerRefresh = nil
			meta._pickerRemove = nil
		end
	end
	function api.Destroy()
		if api._destroyed then return end
		api.Closed = true
		api._destroyed = true
		removeListeners()
		removeFromFloats(win, api)
		if win._quickOverlay == api then win._quickOverlay = nil end
		if gui.Parent then gui:Destroy() end
	end
	function api.Close()
		if api.Closed or api._destroyed then return end
		api.Closed = true
		removeListeners()
		if win._quickOverlay == api then win._quickOverlay = nil end
		tween(backdrop, { BackgroundTransparency = 1 }, .25, QUINT)
		tween(scale, { Scale = .92 }, .28, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween(root, { Position = UDim2.new(.5, 0, .5, 30) }, .28, QUINT)
		tween(body, { GroupTransparency = 1 }, .2, QUINT)
		tween(shadow, { ImageTransparency = 1 }, .2)
		task.delay(.3, function() api.Destroy() end)
	end
	closeBtn.MouseButton1Click:Connect(function() api.Close() end)
	backdrop.MouseButton1Click:Connect(function() api.Close() end)
	api._escapeConnection = UIS.InputBegan:Connect(function(input, processed)
		if not api.Closed and not processed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
			api.Close()
		end
	end)

	win._quickOverlay = api
	table.insert(win._floats, api)
	rebuild()

	tween(backdrop, { BackgroundTransparency = .45 }, .3, QUINT)
	tween(root, { Position = UDim2.new(.5, 0, .5, 0) }, .65, LIQUID)
	tween(scale, { Scale = 1 }, .6, SPRING)
	tween(body, { GroupTransparency = 0 }, .28, QUINT)
	tween(shadow, { ImageTransparency = .5 }, .4)
end
