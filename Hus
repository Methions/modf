	local footer = new("Frame", {
		Position = UDim2.new(0, 0, 1, -footerH), Size = UDim2.new(1, 0, 0, footerH), BackgroundTransparency = 1, ZIndex = 4, Parent = body,
	})
	local footerText = mkText {
		Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -150, 1, 0), Text = "", TextSize = 12, FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted, ZIndex = 5, Parent = footer,
