		Name = "Island", Position = UDim2.fromOffset(0, PILL_H), Size = UDim2.new(1, 0, 1, -PILL_H), BackgroundTransparency = 1,
		GroupTransparency = 1, Visible = false, ZIndex = 62, Parent = body,
	})
