local GarboRuntime = {
    Busy = false,
    Options = {},
    NodeLimit = 4000000,
    YieldEvery = 64,
    SliceTime = 0.004,
    SliceTimeProvider = nil,
    Cancel = nil,
    NextPollNode = 0,
    LastYieldAt = 0,
    StopReason = nil,
    LastStats = {},
    PonderStopRequested = false,
}

local function GarboIsCancelled()
    if GarboRuntime.PonderStopRequested == true
        and GarboRuntime.Options
        and GarboRuntime.Options.IsPonder == true then
        return true
    end
    if type(GarboRuntime.Cancel) ~= "function" then
        return false
    end
    local ok, cancelled = pcall(GarboRuntime.Cancel)
    return not ok or cancelled == true
end

local function GarboPollSearch()
    if not g_searchValid then
        return true
    end

    local nodes = (tonumber(g_nodeCount) or 0) + (tonumber(g_qNodeCount) or 0)
    if nodes < (GarboRuntime.NextPollNode or 0) then
        return false
    end
    GarboRuntime.NextPollNode = nodes + math.max(16, GarboRuntime.YieldEvery or 64)

    local now = os.clock()
    if GarboIsCancelled() then
        GarboRuntime.StopReason = "cancelled"
        g_searchValid = false
        return true
    end

    if GarboRuntime.NodeLimit > 0 and nodes >= GarboRuntime.NodeLimit then
        GarboRuntime.StopReason = "node limit"
        g_searchValid = false
        return true
    end

    if g_timeout > 0 and now - g_startTime >= g_timeout then
        GarboRuntime.StopReason = "time limit"
        g_searchValid = false
        return true
    end

    local slice = tonumber(GarboRuntime.SliceTime) or 0.004
    if type(GarboRuntime.SliceTimeProvider) == "function" then
        local ok, supplied = pcall(GarboRuntime.SliceTimeProvider)
        if ok and tonumber(supplied) then
            slice = tonumber(supplied)
        end
    end
    slice = math.clamp(slice, 0.001, 0.020)

    if now - (GarboRuntime.LastYieldAt or now) >= slice then
        if task and type(task.wait) == "function" then
            task.wait()
        end
        GarboRuntime.LastYieldAt = os.clock()

        if GarboIsCancelled() then
            GarboRuntime.StopReason = "cancelled"
            g_searchValid = false
            return true
        end
        if GarboRuntime.NodeLimit > 0 and nodes >= GarboRuntime.NodeLimit then
            GarboRuntime.StopReason = "node limit"
            g_searchValid = false
            return true
        end
        if g_timeout > 0 and os.clock() - g_startTime >= g_timeout then
            GarboRuntime.StopReason = "time limit"
            g_searchValid = false
            return true
        end
    end

    return false
end

