            local _rank = 10 - bit32.rshift(_square, 4)
            local _relativeRank = _side == colorWhite and (_rank - 1) or (8 - _rank)
            if _pawnFiles[_file + 1] == 0 then
                _whiteScore = _whiteScore + _sign * (_enemyPawnFiles[_file + 1] == 0 and 28 or 16)
            end
            if _relativeRank == 6 then
                _whiteScore = _whiteScore + _sign * 34
            end
            _square = g_pieceList[_pieceIndex + 1]
            _pieceIndex = _pieceIndex + 1
        end

        -- Knights are rewarded for central, advanced outposts.
        _pieceIndex = bit32.lshift(bit32.bor(_side, pieceKnight), 4)
        _square = g_pieceList[_pieceIndex + 1]
        _pieceIndex = _pieceIndex + 1
        while _square ~= 0 do
            local _file = bit32.band(_square, 15) - 4
            local _rank = 10 - bit32.rshift(_square, 4)
            local _relativeRank = _side == colorWhite and _rank or (9 - _rank)
            if _file >= 2 and _file <= 5 and _relativeRank >= 3 and _relativeRank <= 5 then
                _whiteScore = _whiteScore + _sign * 18
            end
            _square = g_pieceList[_pieceIndex + 1]
            _pieceIndex = _pieceIndex + 1
        end

        -- King shelter matters in the middlegame; king centralization matters
        -- after queens and heavy pieces have disappeared.
        local _king = g_pieceList[bit32.lshift(bit32.bor(_side, pieceKing), 4) + 1]
        if _king ~= 0 then
            local _file = bit32.band(_king, 15) - 4
            local _rank = 10 - bit32.rshift(_king, 4)
            local _forward = _side == colorWhite and -16 or 16
            local _shield = 0
            for _df = -1, 1 do
                local _targetFile = _file + _df
                if _targetFile >= 0 and _targetFile <= 7 then
                    local _target = _king + _forward + _df
                    if g_board[_target + 1] == bit32.bor(_side, piecePawn) then
                        _shield = _shield + 1
                    end
                end
            end
            _whiteScore = _whiteScore + _sign * ((_shield * 14) - ((3 - _shield) * 6)) * _middlegameWeight
            local _centrality = 4 - math.abs(_file - 3.5) - math.abs(_rank - 3.5)
            if _centrality > 0 then
                _whiteScore = _whiteScore + _sign * _centrality * 18 * _endgameWeight
            end
        end

        if _side == colorWhite and _whiteBishops >= 2 then
            _whiteScore = _whiteScore + 70
        elseif _side == 0 and _blackBishops >= 2 then
            _whiteScore = _whiteScore - 70
        end
    end
    return _whiteScore
end
function Evaluate()
    local _legacy = RobertLegacyEvaluate()
    local _whiteBase = g_toMove == colorWhite and _legacy or -_legacy
    local _whiteScore = _whiteBase + RobertPositionEvaluation()
    return g_toMove == colorWhite and _whiteScore or -_whiteScore
end

function RobertHasLegalMove()
    local _moves = {}
    GenerateCaptureMoves(_moves)
    GenerateAllMoves(_moves)
    for _i = 1, #_moves do
        if MakeMove(_moves[_i]) then
            UnmakeMove(_moves[_i])
            return true
        end
    end
    return false
end

function RobertMoveOrderScore(_move)
    local _from = bit32.band(_move, 255)
    local _to = bit32.band(bit32.rshift(_move, 8), 255)
    local _attacker = bit32.band(g_board[_from + 1], 15)
    local _victim = bit32.band(g_board[_to + 1], 15)
    if bit32.band(_move, moveflagEPC) ~= 0 then
        _victim = bit32.bor(piecePawn, 8 - g_toMove)
    end
    local _score = (g_seeValues[_victim + 1] or 0) * 100 - (g_seeValues[_attacker + 1] or 0) * 4
    if bit32.band(_move, moveflagPromoteQueen) ~= 0 then
        _score = _score + 900
    elseif bit32.band(_move, moveflagPromotion) ~= 0 then
        _score = _score + 300
    end
    return _score
end

function RobertSortMoves(_moves)
    table.sort(_moves, function(_left, _right)
        return RobertMoveOrderScore(_left) > RobertMoveOrderScore(_right)
    end)
end

function RobertQSearch(_alpha, _beta, _ply)
    g_qNodeCount = g_qNodeCount + 1
    if GarboPollSearch() then
        return _alpha
    end
    if _ply > 0 then
        local _repetitions = RobertRepetitionCount()
        if g_move50 >= 100 or _repetitions >= 2 then
            if not RobertHasLegalMove() then
                return g_inCheck and (-2000000 + _ply) or RobertStalemateScore()
            end
            return RobertDrawScore()
        end
        if _repetitions == 1 then
            return RobertCycleScore()
        end
    end
    if RobertIsInsufficientMaterial() then
        return RobertDrawScore()
    end
    if _ply >= (tonumber(_G.RobertSettings.MaxSearchPly) or 112) then
        if not RobertHasLegalMove() then
            return g_inCheck and (-2000000 + _ply) or RobertStalemateScore()
        end
        return Evaluate()
    end

    local _inCheck = g_inCheck
    local _standPat = nil
    local _standPatCutoff = false
    if not _inCheck then
        _standPat = Evaluate()
        _standPatCutoff = _standPat >= _beta
        if _standPat > _alpha then
            _alpha = _standPat
        end
    end

    if _ply >= (tonumber(_G.RobertSettings.MaxQuiescencePly) or 40) and not _inCheck then
        if not RobertHasLegalMove() then
            return RobertStalemateScore()
        end
        return _alpha
    end

    local _moves = {}
    GenerateCaptureMoves(_moves)
    if _inCheck then
        GenerateAllMoves(_moves)
    else
        -- Quiet promotions are forcing moves and must not disappear at the horizon.
        local _quietPawnMoves = {}
        local _pawnIndex = bit32.lshift(bit32.bor(g_toMove, piecePawn), 4)
        local _pawnSquare = g_pieceList[_pawnIndex + 1]
        _pawnIndex = _pawnIndex + 1
        while _pawnSquare ~= 0 do
            GeneratePawnMoves(_quietPawnMoves, _pawnSquare)
            _pawnSquare = g_pieceList[_pawnIndex + 1]
            _pawnIndex = _pawnIndex + 1
        end
        for _i = 1, #_quietPawnMoves do
            if bit32.band(_quietPawnMoves[_i], moveflagPromotion) ~= 0 then
                _moves[#_moves + 1] = _quietPawnMoves[_i]
            end
        end
    end
    RobertSortMoves(_moves)

    local _legalCount = 0
    local _legalCaptureCount = 0
    local _best = _inCheck and (-2000000 + _ply) or _alpha
    for _i = 1, #_moves do
        local _move = _moves[_i]
        local _isEnPassant = bit32.band(_move, moveflagEPC) ~= 0
        local _isPromotion = bit32.band(_move, moveflagPromotion) ~= 0
        if _inCheck or _isEnPassant or _isPromotion or See(_move) then
            if MakeMove(_move) then
                _legalCount = _legalCount + 1
                if not _inCheck then
                    _legalCaptureCount = _legalCaptureCount + 1
                end
                if _standPatCutoff and not _inCheck then
                    UnmakeMove(_move)
                    return _standPat
                end
                local _score = -RobertQSearch(-_beta, -_alpha, _ply + 1)
                UnmakeMove(_move)
                if not g_searchValid then
                    return _alpha
                end
                if _score > _best then
                    _best = _score
                end
                if _score > _alpha then
                    _alpha = _score
                end
                if _alpha >= _beta then
                    return _alpha
                end
            end
        end
    end

    if _inCheck then
        if _legalCount == 0 then
            return -2000000 + _ply
        end
        return _best
    end

    -- Captures can all be illegal (pins/check exposure). Detect stalemate before
    -- returning a static score, otherwise a horizon stalemate looks like a win.
    if _legalCaptureCount == 0 and not RobertHasLegalMove() then
        return RobertStalemateScore()
    end
    -- Only accept a stand-pat beta cutoff after proving the position has at
    -- least one legal move; otherwise a stalemate would masquerade as a win.
    if _standPatCutoff then
        return _standPat
    end
    return _alpha
end

function RobertStoreTT(_score, _depth, _flag, _bestMove, _ply)
    local _stored = _score
    if _stored > 1900000 - 10000 then
        _stored = _stored + _ply
    elseif _stored < -1900000 + 10000 then
        _stored = _stored - _ply
    end
    local _index = bit32.band(g_hashKeyLow, g_hashMask) + 1
    local _old = g_hashTable[_index]
    local _repetitionCount = RobertRepetitionCount()
    -- A repeated root still needs a best-move entry so iterative deepening can
    -- return the move it actually calculated. Repetition-sensitive interior
    -- scores are never cached because their value depends on the current path.
    if g_nullSearchDepth > 0 or (_ply > 0 and _repetitionCount > 0) then
        return
    end
    if _old == nil or _old.lock ~= g_hashKeyHigh
        or _old.castleRights ~= g_castleRights
        or _old.ep ~= g_enPassentSquare
        or _old.move50 ~= g_move50
        or _old.rootSide ~= _G.RobertSearchRootSide
        or _old.rootRepetitionCount ~= _repetitionCount
        or _depth >= (_old.hashDepth or 0) then
        g_hashTable[_index] = {
            lock = g_hashKeyHigh,
            value = _stored,
            flags = _flag,
            hashDepth = _depth,
            bestMove = _bestMove,
            castleRights = g_castleRights,
            ep = g_enPassentSquare,
            move50 = g_move50,
            rootSide = _G.RobertSearchRootSide,
            rootRepetitionCount = _repetitionCount,
        }
    end
end

function RobertNegamax(_depth, _ply, _alpha, _beta, _allowNull)
    g_nodeCount = g_nodeCount + 1
    if GarboPollSearch() then
        return 0
    end

    if _ply > 0 then
        local _repetitions = RobertRepetitionCount()
        if g_move50 >= 100 or _repetitions >= 2 then
            if not RobertHasLegalMove() then
                return g_inCheck and (-2000000 + _ply) or RobertStalemateScore()
            end
            return RobertDrawScore()
        end
        if _repetitions == 1 then
            return RobertCycleScore()
        end
        if RobertIsInsufficientMaterial() then
            return RobertDrawScore()
        end
    end
    if _ply >= (tonumber(_G.RobertSettings.MaxSearchPly) or 112) then
        if not RobertHasLegalMove() then
            return g_inCheck and (-2000000 + _ply) or RobertStalemateScore()
        end
        return Evaluate()
    end

    local _inCheck = g_inCheck
    if _inCheck then
        _depth = _depth + 1
    end
    if _depth <= 0 then
        return RobertQSearch(_alpha, _beta, _ply)
    end

    local _originalAlpha = _alpha
    local _bestScore = -2000000
    local _bestMove = nil
    local _ttIndex = bit32.band(g_hashKeyLow, g_hashMask) + 1
    local _tt = g_hashTable[_ttIndex]
    local _ttPositionValid = _tt ~= nil
        and _tt.lock == g_hashKeyHigh
        and _tt.castleRights == g_castleRights
        and _tt.ep == g_enPassentSquare
        and _tt.move50 == g_move50
    if _ttPositionValid then
        -- Even a ponder entry from the other root side supplies a useful hash
        -- move; only score cutoffs require the same contempt perspective.
        _bestMove = _tt.bestMove
        if _tt.rootSide == _G.RobertSearchRootSide
            and _tt.rootRepetitionCount == RobertRepetitionCount()
            and (_tt.hashDepth or 0) >= _depth
            and RobertRepetitionCount() == 0 then
            local _ttScore = _tt.value
            if _ttScore > 1900000 - 10000 then
                _ttScore = _ttScore - _ply
            elseif _ttScore < -1900000 + 10000 then
                _ttScore = _ttScore + _ply
            end
            if _tt.flags == hashflagExact then
                return _ttScore
            elseif _tt.flags == hashflagAlpha and _ttScore <= _alpha then
                return _ttScore
            elseif _tt.flags == hashflagBeta and _ttScore >= _beta then
                return _ttScore
            end
        end
    end

    -- Null-move pruning: disabled in check, at root, and in pawn/minor-only
    -- endings where passing can create false tactical cutoffs.
    local _side = g_toMove
    -- Require a rook or queen before null pruning; minor-only and pawn
    -- endings are especially vulnerable to zugzwang false cutoffs.
    local _hasBigPiece = g_pieceCount[bit32.bor(_side, pieceRook) + 1] > 0
        or g_pieceCount[bit32.bor(_side, pieceQueen) + 1] > 0
    if _allowNull and _ply > 0 and _depth >= 3 and not _inCheck and _hasBigPiece then
        local _oldEp = g_enPassentSquare
        g_enPassentSquare = -1
        g_toMove = 8 - g_toMove
        g_baseEval = -g_baseEval
        g_hashKeyLow = bit32.bxor(g_hashKeyLow, g_zobristBlackLow)
        g_hashKeyHigh = bit32.bxor(g_hashKeyHigh, g_zobristBlackHigh)
        local _reduction = 2 + math.floor(_depth / 5)
        g_nullSearchDepth = g_nullSearchDepth + 1
        local _nullScore = -RobertNegamax(_depth - 1 - _reduction, _ply + 1, -_beta, -_beta + 1, false)
        g_nullSearchDepth = math.max(0, g_nullSearchDepth - 1)
        g_hashKeyLow = bit32.bxor(g_hashKeyLow, g_zobristBlackLow)
        g_hashKeyHigh = bit32.bxor(g_hashKeyHigh, g_zobristBlackHigh)
        g_toMove = 8 - g_toMove
        g_baseEval = -g_baseEval
        g_enPassentSquare = _oldEp
        if not g_searchValid then
            return 0
        end
        if _nullScore >= _beta then
            -- Verify high-depth null cutoffs at the real position. This keeps
            -- zugzwang-like positions from being discarded on a speculative pass.
            if _depth >= 8 then
                local _verifyScore = RobertNegamax(
                    _depth - 1 - _reduction,
                    _ply,
                    _beta - 1,
                    _beta,
                    false
                )
                if not g_searchValid then
                    return 0
                end
                if _verifyScore >= _beta then
                    return _verifyScore
                end
            else
                return _nullScore
            end
        end
    end

    local _picker = {}
    local _killer1 = g_killers[_ply + 1] and g_killers[_ply + 1][1] or 0
    local _killer2 = g_killers[_ply + 1] and g_killers[_ply + 1][2] or 0
    MovePicker(_picker, _bestMove, _depth, _killer1, _killer2)

    local _legalMoves = 0
    local _moveNumber = 0
    while true do
        local _move = nextMove(_picker)
        if _move == 0 then
            break
        end
        local _from = bit32.band(_move, 255)
        local _to = bit32.band(bit32.rshift(_move, 8), 255)
        local _quiet = g_board[_to + 1] == 0 and bit32.band(_move, 16711680) == 0
        local _nextDepth = _depth - 1

        if MakeMove(_move) then
            _legalMoves = _legalMoves + 1
            _moveNumber = _moveNumber + 1
            local _score
            local _reduction = 0
            if _moveNumber >= 4 and _depth >= 3 and _quiet and not _inCheck and not g_inCheck then
                _reduction = math.clamp(math.floor((math.log(_depth) * math.log(_moveNumber)) / 2.2), 1, _depth - 2)
            end

            if _moveNumber == 1 then
                _score = -RobertNegamax(_nextDepth, _ply + 1, -_beta, -_alpha, true)
            else
                _score = -RobertNegamax(_nextDepth - _reduction, _ply + 1, -_alpha - 1, -_alpha, true)
                if _score > _alpha and _reduction > 0 and g_searchValid then
                    _score = -RobertNegamax(_nextDepth, _ply + 1, -_alpha - 1, -_alpha, true)
                end
                if _score > _alpha and _score < _beta and g_searchValid then
                    _score = -RobertNegamax(_nextDepth, _ply + 1, -_beta, -_alpha, true)
                end
            end

            UnmakeMove(_move)
            if not g_searchValid then
                return _alpha
            end

            if _score > _bestScore then
                _bestScore = _score
                _bestMove = _move
            end
            if _score > _alpha then
                _alpha = _score
            end
            if _alpha >= _beta then
                if _quiet then
                    if g_killers[_ply + 1] then
                        if g_killers[_ply + 1][1] ~= _move then
                            g_killers[_ply + 1][2] = g_killers[_ply + 1][1]
                            g_killers[_ply + 1][1] = _move
                        end
                    end
                    local _piece = bit32.band(g_board[_from + 1], 15)
                    local _history = historyTable[_piece + 1]
                    _history[_to + 1] = (_history[_to + 1] or 0) + _depth * _depth
                    if _history[_to + 1] > 32767 then
                        for _historyIndex = 1, 256 do
                            _history[_historyIndex] = bit32.rshift(_history[_historyIndex], 1)
                        end
                    end
                end
                RobertStoreTT(_bestScore, _depth, hashflagBeta, _bestMove, _ply)
                return _bestScore
            end
        end
    end

    if _legalMoves == 0 then
        if _inCheck then
            return -2000000 + _ply
        end
        return RobertStalemateScore()
    end

    local _flag = hashflagExact
    if _bestScore <= _originalAlpha then
        _flag = hashflagAlpha
    elseif _bestScore >= _beta then
        _flag = hashflagBeta
    end
    RobertStoreTT(_bestScore, _depth, _flag, _bestMove, _ply)
    return _bestScore
end

function QSearch(_alpha, _beta, _ply)
    return RobertQSearch(_alpha, _beta, _ply)
end

function RobertLoadRepetitionHistory(_history, _currentFen)
    -- Repetition context cannot be reconstructed from a FEN alone. The caller
    -- may supply prior FENs (oldest to newest), excluding the current FEN.
    if type(_history) ~= "table" or #_history == 0 then
        InitializeFromFen(_currentFen)
        g_moveCount = 0
        g_moveUndoStack = {}
        g_repMoveStack = {g_hashKeyLow}
        g_repMoveStackHigh = {g_hashKeyHigh}
        g_repCastleStack = {g_castleRights}
        g_repEpStack = {g_enPassentSquare}
        _G.RobertRepCounts = {}
        RobertRepAdjust(g_hashKeyLow, g_hashKeyHigh, g_castleRights, g_enPassentSquare, 1)
        g_nullSearchDepth = 0
        return 0
    end

    local _positions = {}
    local _historyStart = math.max(1, #_history - 149)
    local _previousSide = nil
    local _previousFullmove = nil
    local _previousKey = nil
    for _i = _historyStart, #_history do
        local _fen = _history[_i]
        if type(_fen) == "string" and _fen ~= "" then
            local _fields = {}
            for _field in string.gmatch(_fen, "%S+") do
                _fields[#_fields + 1] = _field
            end
            local _ok = pcall(InitializeFromFen, _fen)
            if _ok then
                local _key = table.concat(_fields, " ")
                local _side = _fields[2]
                local _fullmove = tonumber(_fields[6]) or 1
                if _key ~= _previousKey then
                    -- If the caller supplies one FEN per engine turn, two
                    -- successive snapshots have the same side to move. Insert
                    -- unknown opponent plies so same-side repetition parity is
                    -- still exact. Alternating snapshots already represent each ply.
                    if _previousSide ~= nil and _side == _previousSide then
                        local _gap = math.max(2, (_fullmove - _previousFullmove) * 2)
                        for _gapIndex = 2, _gap do
                            _positions[#_positions + 1] = {Low = -1, High = -1, Castle = -1, Ep = -2}
                        end
                    end
                    _positions[#_positions + 1] = {
                        Low = g_hashKeyLow,
                        High = g_hashKeyHigh,
                        Castle = g_castleRights,
                        Ep = g_enPassentSquare,
                    }
                    _previousSide = _side
                    _previousFullmove = _fullmove
                    _previousKey = _key
                end
            end
        end
    end

    InitializeFromFen(_currentFen)
    local _currentFields = {}
    for _field in string.gmatch(_currentFen, "%S+") do
        _currentFields[#_currentFields + 1] = _field
    end
    local _currentSide = _currentFields[2]
    local _currentFullmove = tonumber(_currentFields[6]) or 1
    if _previousSide ~= nil and _currentSide == _previousSide then
        local _gap = math.max(2, (_currentFullmove - (_previousFullmove or _currentFullmove)) * 2)
        for _gapIndex = 2, _gap do
            _positions[#_positions + 1] = {Low = -1, High = -1, Castle = -1, Ep = -2}
        end
    end
    g_moveCount = #_positions
    g_moveUndoStack = {}
    g_repMoveStack = {}
    g_repMoveStackHigh = {}
    g_repCastleStack = {}
    g_repEpStack = {}
    for _i = 1, #_positions do
        g_repMoveStack[_i] = _positions[_i].Low
        g_repMoveStackHigh[_i] = _positions[_i].High
        g_repCastleStack[_i] = _positions[_i].Castle
        g_repEpStack[_i] = _positions[_i].Ep
    end
    local _rootIndex = #_positions + 1
    g_repMoveStack[_rootIndex] = g_hashKeyLow
    g_repMoveStackHigh[_rootIndex] = g_hashKeyHigh
    g_repCastleStack[_rootIndex] = g_castleRights
    g_repEpStack[_rootIndex] = g_enPassentSquare
    _G.RobertRepCounts = {}
    for _i = 1, _rootIndex do
        if g_repMoveStack[_i] ~= nil and g_repMoveStack[_i] >= 0 then
            RobertRepAdjust(
                g_repMoveStack[_i],
                g_repMoveStackHigh[_i],
                g_repCastleStack[_i],
                g_repEpStack[_i],
                1
            )
        end
    end
    g_nullSearchDepth = 0
    return #_positions
end

function RobertUpdateAutoHistory(_fen, _options)
    _options = type(_options) == "table" and _options or {}
    _G.RobertAutoHistory = _G.RobertAutoHistory or {Positions = {}, Last = nil, GameId = nil}
    if _options.ResetRepetitionHistory == true
        or (_options.GameId ~= nil and _G.RobertAutoHistory.GameId ~= _options.GameId) then
        _G.RobertAutoHistory = {Positions = {}, Last = nil, GameId = _options.GameId}
    end

    local _fields = {}
    for _field in string.gmatch(_fen, "%S+") do
        _fields[#_fields + 1] = _field
    end
    local _key = table.concat(_fields, " ")
    local _side = _fields[2]
    local _halfmove = tonumber(_fields[5]) or 0
    local _fullmove = tonumber(_fields[6]) or 1
    local _state = _G.RobertAutoHistory
    local _last = _state.Last

    -- A pawn move/capture, a new game, or a discontinuous FEN stream invalidates
    -- the old reversible-position window. Do not invent missing positions.
    if _halfmove == 0 or (_last and _fullmove < (_last.Fullmove or 1))
        or (_last and _fullmove == 1 and (_last.Fullmove or 1) > 1) then
        _state.Positions = {}
        _last = nil
    end

    if _last and _last.Key == _key then
        local _priorDuplicate = {}
        for _i = 1, math.max(0, #_state.Positions - 1) do
            _priorDuplicate[#_priorDuplicate + 1] = _state.Positions[_i]
        end
        return _priorDuplicate
    end

    if _last then
        local _expectedFullmove = _last.Fullmove or 1
        if _last.Side == _side then
            _expectedFullmove = _expectedFullmove + 1
        elseif _last.Side == "b" and _side == "w" then
            _expectedFullmove = _expectedFullmove + 1
        end
        if _fullmove ~= _expectedFullmove then
            _state.Positions = {}
            _last = nil
        end
    end

    local _prior = {}
    for _i = 1, #_state.Positions do
        _prior[_i] = _state.Positions[_i]
    end
    _state.Positions[#_state.Positions + 1] = _fen
    while #_state.Positions > 150 do
        table.remove(_state.Positions, 1)
    end
    _state.Last = {Key = _key, Side = _side, Fullmove = _fullmove}
    if _options.GameId ~= nil then
        _state.GameId = _options.GameId
    end
    return _prior
end

function RobertBuildPV(_firstMove, _maxPlies)
    local _pv = {}
    local _made = {}
    local _move = _firstMove
    for _ply = 1, math.max(1, tonumber(_maxPlies) or 20) do
        if _move == nil or _move == 0 or not IsHashMoveValid(_move) then
            break
        end
        _pv[#_pv + 1] = FormatMove(_move)
        if not MakeMove(_move) then
            break
        end
        _made[#_made + 1] = _move
        local _entry = g_hashTable[bit32.band(g_hashKeyLow, g_hashMask) + 1]
        if _entry == nil or _entry.lock ~= g_hashKeyHigh
            or _entry.castleRights ~= g_castleRights
            or _entry.ep ~= g_enPassentSquare
            or _entry.move50 ~= g_move50
            or _entry.rootSide ~= _G.RobertSearchRootSide
            or _entry.rootRepetitionCount ~= RobertRepetitionCount()
            or _entry.bestMove == nil then
            break
        end
        _move = _entry.bestMove
    end
    for _i = #_made, 1, -1 do
        UnmakeMove(_made[_i])
    end
    return _pv
end

function Search(_maxDepth)
    local _targetDepth = math.clamp(math.floor(tonumber(_maxDepth) or _G.RobertSettings.DefaultDepth or 20), 1, 32)
    _G.RobertSearchRootSide = g_toMove
    _G.RobertPrincipalVariation = {}
    _G.RobertPonderMove = nil
    local _bestMove = 0
    local _bestScore = Evaluate()
    local _completedDepth = 0
    local _previousScore = 0
    local _infinite = 2000000

    g_globalPly = g_globalPly + 1
    g_nodeCount = 0
    g_qNodeCount = 0
    g_searchValid = true
    g_foundmove = 0
    g_foundvalue = 0
    g_finCnt = 0
    g_completedDepth = 0
    g_startTime = os.clock()

    for _depth = 1, _targetDepth do
        if not g_searchValid then
            break
        end
        local _alpha = -_infinite
        local _beta = _infinite
        if _depth >= 3 then
            _alpha = math.max(-_infinite, _previousScore - 100)
            _beta = math.min(_infinite, _previousScore + 100)
        end

        local _score = RobertNegamax(_depth, 0, _alpha, _beta, true)
        if g_searchValid and (_score <= _alpha or _score >= _beta) then
            _score = RobertNegamax(_depth, 0, -_infinite, _infinite, true)
        end
        if not g_searchValid then
            break
        end

        local _rootEntry = g_hashTable[bit32.band(g_hashKeyLow, g_hashMask) + 1]
        if _rootEntry ~= nil and _rootEntry.lock == g_hashKeyHigh
            and _rootEntry.castleRights == g_castleRights
            and _rootEntry.ep == g_enPassentSquare
            and _rootEntry.move50 == g_move50
            and _rootEntry.rootSide == _G.RobertSearchRootSide
            and _rootEntry.rootRepetitionCount == RobertRepetitionCount()
            and (_rootEntry.hashDepth or 0) >= _depth
            and _rootEntry.bestMove ~= nil then
            _bestMove = _rootEntry.bestMove
            _bestScore = _score
            _previousScore = _score
            _completedDepth = _depth
            g_completedDepth = _depth
        end
        if math.abs(_score) > 1900000 - 128 then
            break
        end
        if task and type(task.wait) == "function" then
            task.wait()
        end
    end

    if _bestMove == 0 and (g_searchValid or GarboRuntime.StopReason == "time limit" or GarboRuntime.StopReason == "node limit") then
        local _legal = GenerateValidMoves()
        if #_legal > 0 then
            _bestMove = _legal[1]
            _bestScore = Evaluate()
        end
    end

    g_completedDepth = _completedDepth
    _G.RobertPrincipalVariation = _bestMove ~= 0 and RobertBuildPV(_bestMove, math.min(32, math.max(1, _completedDepth))) or {}
    _G.RobertPonderMove = _G.RobertPrincipalVariation[2]
    finishMoveCallback(_bestMove, _bestScore, _completedDepth)
end


InitializeEval()
ResetGame()

v1.Name = "GarboChess"
v1.EngineName = "GarboChess"
v1.LastStats = GarboRuntime.LastStats

function v1:Configure(options)
    options = type(options) == "table" and options or {}
    if options.SliceTime ~= nil then
        GarboRuntime.SliceTime = math.clamp(tonumber(options.SliceTime) or 0.004, 0.001, 0.020)
    end
    if options.YieldEvery ~= nil then
        GarboRuntime.YieldEvery = math.clamp(math.floor(tonumber(options.YieldEvery) or 64), 16, 1024)
    end
    if options.NodeLimit ~= nil then
        GarboRuntime.NodeLimit = math.clamp(math.floor(tonumber(options.NodeLimit) or 2500000), 10000, 50000000)
    end
    if options.AutoPonder ~= nil then
        _G.RobertSettings.AutoPonder = options.AutoPonder == true
    end
    if options.PonderTime ~= nil then
        _G.RobertSettings.PonderTime = math.clamp(tonumber(options.PonderTime) or 20, 0.15, 20)
    end
    if options.DefaultDepth ~= nil then
        _G.RobertSettings.DefaultDepth = math.clamp(math.floor(tonumber(options.DefaultDepth) or 20), 1, 32)
    end
    if options.DrawContempt ~= nil then
        _G.RobertSettings.DrawContempt = math.max(0, tonumber(options.DrawContempt) or 1200)
    end
    if options.RepetitionCyclePenalty ~= nil then
        _G.RobertSettings.RepetitionCyclePenalty = math.max(0, tonumber(options.RepetitionCyclePenalty) or 650)
    end
    if options.StalematePenalty ~= nil then
        _G.RobertSettings.StalematePenalty = math.max(0, tonumber(options.StalematePenalty) or 1600)
    end
    if options.PonderMaxDepth ~= nil then
        _G.RobertSettings.PonderMaxDepth = math.clamp(math.floor(tonumber(options.PonderMaxDepth) or 32), 1, 32)
    end
    return true
end

function v1:GetStats()
    return GarboRuntime.LastStats or {}
end

-- Normal searches automatically start an opponent-turn ponder after the chosen
-- move. Pass options.AutoPonder=false or Configure({AutoPonder=false}) to disable.
-- Pondering stops as soon as the next real-position request arrives; the TT is
-- retained so the actual move can reuse the predicted branch ordering.
function v1:GetBestMoveFromFEN(fen, thinkTime, options)
    if type(fen) ~= "string" or fen == "" then
        return nil
    end

    options = type(options) == "table" and options or {}
    if options.IsPonder ~= true then
        _G.RobertPonder = _G.RobertPonder or {Generation = 0, Last = nil}
        _G.RobertPonder.Generation = (_G.RobertPonder.Generation or 0) + 1
    end
    local fields = {}
    for field in string.gmatch(fen, "%S+") do
        fields[#fields + 1] = field
    end
    if #fields < 4 or (fields[2] ~= "w" and fields[2] ~= "b") then
        return nil
    end

    local requested = math.clamp(tonumber(thinkTime) or 1.0, 0.15, 20)

    local function requestCancelled()
        if type(options.Cancel) ~= "function" then
            return false
        end
        local cancelOK, cancelled = pcall(options.Cancel)
        return not cancelOK or cancelled == true
    end

    -- A real turn supersedes opponent-turn pondering. The ponderer reaches its
    -- next cooperative poll, preserves the completed TT, and then unwinds.
    if GarboRuntime.Busy and GarboRuntime.Options
        and GarboRuntime.Options.IsPonder == true
        and (options.PonderToken == nil or options.PonderToken ~= GarboRuntime.Options.PonderToken) then
        GarboRuntime.PonderStopRequested = true
    end

    -- Searches are serialized because the board and TT are mutable. A new
    -- request waits for the prior (possibly cancelled) search to unwind.
    local waitStarted = os.clock()
    local waitLimit = math.max(8, requested * 4 + 2)
    while GarboRuntime.Busy do
        if requestCancelled() then
            return nil, nil, {tag = "CANCELLED", message = "Queued GarboChess search was cancelled."}
        end
        if os.clock() - waitStarted >= waitLimit then
            return nil, nil, {tag = "BUSY_TIMEOUT", message = "GarboChess did not release its previous search in time."}
        end
        if not task or type(task.wait) ~= "function" then
            return nil, nil, {tag = "BUSY", message = "GarboChess is busy and cannot yield in this environment."}
        end
        task.wait(0.02)
    end

    if requestCancelled() then
        return nil, nil, {tag = "CANCELLED", message = "Queued GarboChess search was cancelled."}
    end
    local maxDepth = math.clamp(
        math.floor(tonumber(options.TargetDepth or options.MaxDepth) or _G.RobertSettings.DefaultDepth or 20),
        1,
        32
    )
    local nodeLimit = math.clamp(
        math.floor(tonumber(options.NodeLimit) or GarboRuntime.NodeLimit or 2500000),
        10000,
        50000000
    )

    GarboRuntime.Busy = true
    GarboRuntime.Options = options
    GarboRuntime.PonderStopRequested = false
    GarboRuntime.NodeLimit = nodeLimit
    GarboRuntime.YieldEvery = math.clamp(math.floor(tonumber(options.YieldEvery) or GarboRuntime.YieldEvery or 64), 16, 1024)
    GarboRuntime.SliceTime = math.clamp(tonumber(options.SliceTime) or GarboRuntime.SliceTime or 0.004, 0.001, 0.020)
    GarboRuntime.SliceTimeProvider = options.SliceTimeProvider
    GarboRuntime.Cancel = options.Cancel
    GarboRuntime.NextPollNode = 0
    GarboRuntime.LastYieldAt = os.clock()
    GarboRuntime.StopReason = nil

    local started = os.clock()
    local historyCount = 0
    local ok, searchError = pcall(function()
        local _autoHistory = RobertUpdateAutoHistory(fen, options)
        local _history = options.RepetitionHistory or options.History or _autoHistory
        historyCount = RobertLoadRepetitionHistory(_history, fen)
        g_timeout = requested
        g_maxfinCnt = nodeLimit
        g_completedDepth = 0
        Search(maxDepth)
    end)

    local elapsed = os.clock() - started
    local move = ok and g_foundmove ~= 0 and FormatMove(g_foundmove) or nil
    local score = move and tonumber(g_foundvalue) or nil
    local totalNodes = (tonumber(g_nodeCount) or 0) + (tonumber(g_qNodeCount) or 0)
    local stats = {
        Engine = "Robert (GarboChess core)",
        Depth = tonumber(g_completedDepth) or 0,
        TargetDepth = maxDepth,
        DrawContempt = tonumber(_G.RobertSettings.DrawContempt) or 1200,
        RepetitionCyclePenalty = tonumber(_G.RobertSettings.RepetitionCyclePenalty) or 650,
        StalematePenalty = tonumber(_G.RobertSettings.StalematePenalty) or 1600,
        PrincipalVariation = table.concat(_G.RobertPrincipalVariation or {}, " "),
        PVPlies = #(_G.RobertPrincipalVariation or {}),
        PredictedOpponentMove = options.IsPonder == true
            and (_G.RobertPrincipalVariation or {})[1]
            or (_G.RobertPrincipalVariation or {})[2],
        PredictedCounterMove = options.IsPonder == true
            and (_G.RobertPrincipalVariation or {})[2]
            or (_G.RobertPrincipalVariation or {})[3],
        PonderMove = _G.RobertPonderMove,
        IsPonder = options.IsPonder == true,
        RepetitionHistoryPositions = historyCount or 0,
        Nodes = totalNodes,
        MainNodes = tonumber(g_nodeCount) or 0,
        QNodes = tonumber(g_qNodeCount) or 0,
        Elapsed = elapsed,
        NPS = elapsed > 0 and math.floor(totalNodes / elapsed) or 0,
        StopReason = GarboRuntime.StopReason or (ok and "completed" or "error"),
        Error = not ok and tostring(searchError) or nil,
        Move = move,
        Score = score,
    }
    GarboRuntime.Options = {}
    GarboRuntime.SliceTimeProvider = nil
    GarboRuntime.Cancel = nil
    GarboRuntime.Busy = false
    GarboRuntime.PonderStopRequested = false

    if not ok then
        GarboRuntime.LastStats = stats
        v1.LastStats = stats
        warn("[Robert] Search failed: " .. tostring(searchError))
        return nil
    end
    if not move then
        GarboRuntime.LastStats = stats
        v1.LastStats = stats
        return nil, nil, {tag = GarboRuntime.StopReason or "NO_MOVE", message = "Robert did not complete a legal move."}
    end

    local _autoPonder = options.AutoPonder
    if _autoPonder == nil then
        _autoPonder = _G.RobertSettings.AutoPonder
    end
    if _autoPonder == true and options.IsPonder ~= true then
        -- finishMoveCallback has applied Robert's selected move to the internal
        -- board. GetFen now describes the opponent-to-move position.
        local _nextFullmove = tonumber(fields[6]) or 1
        if fields[2] == "b" then
            _nextFullmove = _nextFullmove + 1
        end
        local _ponderFen = GetFen() .. " " .. tostring(g_move50) .. " " .. tostring(_nextFullmove)
        local _ponderOptions = {}
        for _key, _value in pairs(options) do
            if _key ~= "Cancel" and _key ~= "SliceTimeProvider"
                and _key ~= "ResetRepetitionHistory" then
                _ponderOptions[_key] = _value
            end
        end
        _ponderOptions.AutoPonder = false
        if type(options.RepetitionHistory) == "table" or type(options.History) == "table" then
            _ponderOptions.RepetitionHistory = {}
            local _sourceHistory = options.RepetitionHistory or options.History
            for _i = 1, #_sourceHistory do
                _ponderOptions.RepetitionHistory[#_ponderOptions.RepetitionHistory + 1] = _sourceHistory[_i]
            end
            _ponderOptions.RepetitionHistory[#_ponderOptions.RepetitionHistory + 1] = fen
            _ponderOptions.History = nil
        end
        local _started = self:StartPondering(
            _ponderFen,
            tonumber(options.PonderTime) or tonumber(_G.RobertSettings.PonderTime) or 20,
            _ponderOptions
        )
        stats.PonderingStarted = _started == true
        stats.PonderFEN = _started and _ponderFen or nil
    else
        stats.PonderingStarted = false
    end

    GarboRuntime.LastStats = stats
    v1.LastStats = stats
    return move, score, stats
end

function v1:StartPondering(fen, thinkTime, options)
    if type(fen) ~= "string" or fen == "" then
        return false, "A valid opponent-to-move FEN is required."
    end
    if not task or type(task.spawn) ~= "function" then
        return false, "This environment does not support task.spawn for pondering."
    end

    options = type(options) == "table" and options or {}
    thinkTime = tonumber(thinkTime) or tonumber(options.PonderTime) or tonumber(_G.RobertSettings.PonderTime) or 20
    _G.RobertPonder = _G.RobertPonder or {Generation = 0, Last = nil}
    _G.RobertPonder.Generation = (_G.RobertPonder.Generation or 0) + 1
    _G.RobertPonder.Last = nil
    local _token = _G.RobertPonder.Generation
    local _ponderOptions = {}
    for _key, _value in pairs(options) do
        _ponderOptions[_key] = _value
    end
    local _targetDepth = math.clamp(
        math.floor(tonumber(_ponderOptions.TargetDepth) or tonumber(_G.RobertSettings.DefaultDepth) or 20),
        1,
        32
    )
    local _maxDepth = math.clamp(
        math.floor(tonumber(_ponderOptions.PonderMaxDepth) or tonumber(_G.RobertSettings.PonderMaxDepth) or 32),
        _targetDepth,
        32
    )
    _ponderOptions.IsPonder = true
    _ponderOptions.AutoPonder = false
    _ponderOptions.PonderToken = _token
    _ponderOptions.PonderMaxDepth = _maxDepth
    local _externalCancel = _ponderOptions.Cancel
    _ponderOptions.Cancel = function()
        if _G.RobertPonder.Generation ~= _token then
            return true
        end
        if type(_externalCancel) == "function" then
            local _ok, _cancelled = pcall(_externalCancel)
            return not _ok or _cancelled == true
        end
        return false
    end

    task.spawn(function()
        while _G.RobertPonder.Generation == _token do
            _ponderOptions.TargetDepth = _targetDepth
            local _move, _score, _stats = self:GetBestMoveFromFEN(fen, thinkTime, _ponderOptions)
            if _G.RobertPonder.Generation ~= _token then
                break
            end

            _G.RobertPonder.Last = {
                Move = _move,
                Score = _score,
                Stats = _stats,
                FEN = fen,
                Token = _token,
                TargetDepth = _targetDepth,
            }
            if not _move or type(_stats) ~= "table" then
                break
            end

            local _completed = tonumber(_stats.Depth) or 0
            if _stats.StopReason == "cancelled" or _stats.StopReason == "error" then
                break
            end
            if _completed >= _targetDepth then
                if _targetDepth >= _maxDepth then
                    -- At the configured ceiling, keep the ponder session alive
                    -- but idle until the real opponent move or an explicit stop.
                    while _G.RobertPonder.Generation == _token do
                        task.wait(0.25)
                    end
                    break
                end
                _targetDepth = math.min(_maxDepth, _targetDepth + 2)
            elseif _stats.StopReason ~= "time limit" and _stats.StopReason ~= "node limit" then
                break
            end
            -- If a deeper iteration hit its budget, retry that same depth with
            -- the retained TT instead of ending pondering. If it completed,
            -- the next pass adds two plies. Always yield for the live game thread.
            task.wait(0.05)
        end
    end)
    return true, _token
end

function v1:StopPondering()
    _G.RobertPonder = _G.RobertPonder or {Generation = 0, Last = nil}
    _G.RobertPonder.Generation = (_G.RobertPonder.Generation or 0) + 1
    if GarboRuntime.Busy and GarboRuntime.Options and GarboRuntime.Options.IsPonder == true then
        GarboRuntime.PonderStopRequested = true
    end
    return true
end

function v1:GetPonderResult()
    return _G.RobertPonder and _G.RobertPonder.Last or nil
end

function v1:ResetGameHistory(gameId)
    _G.RobertAutoHistory = {Positions = {}, Last = nil, GameId = gameId}
    _G.RobertPonder = _G.RobertPonder or {Generation = 0, Last = nil}
    _G.RobertPonder.Last = nil
    self:StopPondering()
    return true
end

