local function KasparovRunPremove(fen, thinkTime, options)
    if KasparovActive then
        return nil, nil, {Busy = true, Message = "Kasparov is already searching."}
    end

    local fields = KasparovSplitFEN(fen)
    if fields[2] ~= "w" and fields[2] ~= "b" then
        return nil, nil, {Error = "The FEN side-to-move field is invalid."}
    end

    options = type(options) == "table" and options or {}
    local requested = KasparovClamp(tonumber(thinkTime) or 0.9, 0.2, 4)
    local searchOptions = KasparovCopyTable(options)
    searchOptions.UseBook = false
    searchOptions.TargetDepth = KasparovClamp(
        KasparovFloor(tonumber(options.TargetDepth or options.MaxDepth) or KasparovState.TargetDepth or 8),
        1,
        48
    )
    searchOptions.MaxDepth = searchOptions.TargetDepth
    searchOptions.NodeLimit = KasparovClamp(
        KasparovFloor(tonumber(options.NodeLimit) or 3000000),
        100000,
        100000000
    )

    local start = KasparovClock()
    local opponentMove, opponentScore, opponentResult = KasparovAPI.GetBestMoveFromFEN(
        fen,
        KasparovMax(0.1, requested * 0.42),
        searchOptions
    )
    local opponentStats = KasparovAPI:GetStats()

    if type(opponentMove) ~= "string"
        or not opponentMove:match("^[a-h][1-8][a-h][1-8][qrbn]?$") then
        return nil, opponentScore, opponentResult or {
            NoOpponentMove = true,
            OpponentStats = opponentStats,
        }
    end

    if KasparovPremoveCancelled(searchOptions) then
        return nil, nil, {
            Cancelled = true,
            OpponentMove = opponentMove,
            OpponentStats = opponentStats,
        }
    end

    local fromSquare = string.sub(opponentMove, 1, 2)
    local toSquare = string.sub(opponentMove, 3, 4)
    local movingPiece = KasparovFENPieceAt(fields[1], fromSquare)
    local targetPiece = KasparovFENPieceAt(fields[1], toSquare)
    local isPawnMove = movingPiece and string.lower(movingPiece) == "p"
    local isEnPassant = isPawnMove and fields[4] == toSquare and targetPiece == nil
    local isCapture = targetPiece ~= nil or isEnPassant

    -- The engine's finish callback has already applied its selected root move.
    -- Verify the side changed before serializing the predicted reply position.
    local expectedSide = fields[2] == "w" and 0 or colorWhite
    if g_toMove ~= expectedSide then
        return nil, nil, {
            Error = "Kasparov did not complete the predicted opponent move.",
            OpponentMove = opponentMove,
            OpponentStats = opponentStats,
        }
    end

    local halfmove = tonumber(fields[5]) or 0
    if isPawnMove or isCapture then
        halfmove = 0
    else
        halfmove = halfmove + 1
    end

    local fullmove = tonumber(fields[6]) or 1
    if fields[2] == "b" then
        fullmove = fullmove + 1
    end

    local replyFen = KasparovBuildFENFromBoard(halfmove, fullmove)
    if KasparovPremoveCancelled(searchOptions) then
        return nil, nil, {
            Cancelled = true,
            OpponentMove = opponentMove,
            ReplyFEN = replyFen,
            OpponentStats = opponentStats,
        }
    end

    local remaining = requested - (KasparovClock() - start)
    local responseTime = KasparovClamp(
        remaining,
        0.1,
        KasparovMax(0.1, requested * 0.65)
    )
    local premove, score, reaction = KasparovAPI.GetBestMoveFromFEN(
        replyFen,
        responseTime,
        searchOptions
    )

    if type(premove) ~= "string"
        or not premove:match("^[a-h][1-8][a-h][1-8][qrbn]?$") then
        return nil, score, reaction or {
            NoReplyMove = true,
            OpponentMove = opponentMove,
            ReplyFEN = replyFen,
            OpponentStats = opponentStats,
            Stats = KasparovAPI:GetStats(),
        }
    end

    if KasparovPremoveCancelled(searchOptions) then
        return nil, nil, {
            Cancelled = true,
            OpponentMove = opponentMove,
            ReplyFEN = replyFen,
            OpponentStats = opponentStats,
            Stats = KasparovAPI:GetStats(),
        }
    end

    local stats = KasparovAPI:GetStats()
    local pv = KasparovAPI:GetPV(replyFen, options.PVDepth or 15)
    return {
        OpponentMove = opponentMove,
        OpponentScore = opponentScore,
        Move = premove,
        Score = score,
        Reaction = reaction,
        SourceFEN = fen,
        ReplyFEN = replyFen,
        Elapsed = KasparovClock() - start,
        PV = pv,
        OpponentStats = opponentStats,
        Stats = stats,
    }, score, nil
end

function KasparovAPI.GetPremoveFromFEN(a, b, c, d)
    local fen, thinkTime, options
    if a == KasparovAPI or a == nil then
        fen, thinkTime, options = b, c, d
    else
        fen, thinkTime, options = a, b, c
    end

    if type(fen) ~= "string" or fen == "" then
        return nil, nil, {Error = "A valid FEN string is required."}
    end
    return KasparovRunPremove(fen, thinkTime, options)
end

KasparovAPI.GetPremove = KasparovAPI.GetPremoveFromFEN

KasparovAPI.LegacyGetBestMoveFromFEN = KasparovLegacyGetBestMoveFromFEN
KasparovAPI.GetBestMove = KasparovAPI.GetBestMoveFromFEN
KasparovAPI.GetLagStats = KasparovAPI.GetLagDump

_G.__KASPAROV_ENGINE_API = KasparovAPI
_G.__GARBOCHESS_KASPAROV_API = KasparovAPI
_G.__KASPAROV_API = KasparovAPI

return KasparovAPI
