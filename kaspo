local function KasparovFENPieceAt(placement, square)
    if type(placement) ~= "string" or type(square) ~= "string" or #square < 2 then
        return nil
    end

    local file = string.byte(square, 1) - 97
    local rank = tonumber(string.sub(square, 2, 2))
    if file < 0 or file > 7 or not rank or rank < 1 or rank > 8 then
        return nil
    end

    local targetRow = 8 - rank
    local row = 0
    for rankText in string.gmatch(placement, "[^/]+") do
        if row == targetRow then
            local currentFile = 0
            for i = 1, #rankText do
                local character = string.sub(rankText, i, i)
                local emptyCount = tonumber(character)
                if emptyCount then
                    if file >= currentFile and file < currentFile + emptyCount then
                        return nil
                    end
                    currentFile = currentFile + emptyCount
                else
                    if currentFile == file then
                        return character
                    end
                    currentFile = currentFile + 1
                end
            end
            return nil
        end
        row = row + 1
    end
    return nil
end

local function KasparovBuildFENFromBoard(halfmove, fullmove)
    local ranks = {}
    for row = 0, 7 do
        local rankText = {}
        local emptyCount = 0

        for file = 0, 7 do
            local mailboxSquare = (row + 2) * 16 + file + 4
            local piece = g_board[mailboxSquare + 1] or 0
            local pieceType = bit32.band(piece, 7)

            if pieceType == 0 then
                emptyCount = emptyCount + 1
            else
                if emptyCount > 0 then
                    rankText[#rankText + 1] = tostring(emptyCount)
                    emptyCount = 0
                end

                local character = PieceCharList[pieceType + 1]
                if bit32.band(piece, colorWhite) ~= 0 then
                    character = string.upper(character)
                else
                    character = string.lower(character)
                end
                rankText[#rankText + 1] = character
            end
        end

        if emptyCount > 0 then
            rankText[#rankText + 1] = tostring(emptyCount)
        end
        ranks[#ranks + 1] = table.concat(rankText)
    end

    local side = g_toMove == colorWhite and "w" or "b"
    local castle = ""
    if bit32.band(g_castleRights, 1) ~= 0 then castle = castle .. "K" end
    if bit32.band(g_castleRights, 2) ~= 0 then castle = castle .. "Q" end
    if bit32.band(g_castleRights, 4) ~= 0 then castle = castle .. "k" end
    if bit32.band(g_castleRights, 8) ~= 0 then castle = castle .. "q" end
    if castle == "" then castle = "-" end

    local enPassant = "-"
    if g_enPassentSquare and g_enPassentSquare >= 1 then
        enPassant = FormatSquare(g_enPassentSquare)
    end

    return table.concat(ranks, "/")
        .. " " .. side
        .. " " .. castle
        .. " " .. enPassant
        .. " " .. tostring(halfmove or 0)
        .. " " .. tostring(fullmove or 1)
end

local function KasparovPremoveCancelled(options)
