local function KasparovAbort(reason)
    local run = KasparovActive
    if not run then return end
    run.Aborted = true
    run.AbortReason = reason
    if reason == "Cancelled" then
        run.Cancelled = true
    elseif reason == "NodeLimit" then
        run.NodeLimitHit = true
    elseif reason == "TimeLimit" then
        run.TimedOut = true
    end
    g_searchValid = false
end

local function KasparovTouch(kind)
    local run = KasparovActive
    if not run then return true end
    if run.Aborted then return false end

    run.Visited = run.Visited + 1
    if kind == "Q" then
        run.QNodes = run.QNodes + 1
    else
        run.Nodes = run.Nodes + 1
    end

    if run.Visited >= run.NodeLimit then
        KasparovAbort("NodeLimit")
        return false
    end

    if run.Visited % run.YieldEvery ~= 0 then
        return true
    end

    if type(run.Cancel) == "function" then
        local ok, shouldCancel = pcall(run.Cancel)
        if not ok or shouldCancel then
            KasparovAbort("Cancelled")
            return false
        end
    end

    local now = KasparovClock()
    if now >= run.Deadline then
        KasparovAbort("TimeLimit")
        return false
    end

    if type(run.SliceProvider) == "function" then
        local ok, dynamicSlice = pcall(run.SliceProvider)
        if ok and type(dynamicSlice) == "number" then
            run.SliceTime = KasparovClamp(dynamicSlice, 0.001, 0.012)
        end
    end

    local elapsed = now - run.LastYield
    if elapsed > run.PeakSlice then
        run.PeakSlice = elapsed
    end

    if elapsed >= run.SliceTime then
        run.YieldCount = run.YieldCount + 1
        KasparovYield()
        run.LastYield = KasparovClock()
        if run.LastYield >= run.Deadline then
            KasparovAbort("TimeLimit")
            return false
        end
    end

    return true
end

