local function KasparovRunSearch(fen, thinkTime, options)
    options = type(options) == "table" and options or {}
    if KasparovActive then
        return nil, nil, {Busy = true, Message = "Kasparov is already searching."}
    end

    local baseThinkTime = tonumber(thinkTime or options.ThinkTime or options.TimeLimit) or 1.5
    baseThinkTime = KasparovClamp(baseThinkTime, 0.05, 30)
    local multiplier = KasparovClamp(
        tonumber(options.TimeMultiplier) or KasparovState.TimeMultiplier or 1.5, 1, 4
    )
    local timeBudget = KasparovClamp(baseThinkTime * multiplier, 0.05, 60)
    local targetDepth = KasparovClamp(
        KasparovFloor(tonumber(options.TargetDepth or options.MaxDepth) or KasparovState.TargetDepth or 8),
        1,
        48
    )
    local nodeLimit = KasparovClamp(
        KasparovFloor(tonumber(options.NodeLimit) or KasparovState.NodeLimit or 50000000),
        100000,
        100000000
    )
    local yieldEvery = KasparovClamp(
        KasparovFloor(tonumber(options.YieldEvery) or KasparovState.YieldEvery or 32), 8, 256
    )
    local sliceTime = KasparovClamp(
        tonumber(options.SliceTime) or KasparovState.SliceTime or 0.004, 0.001, 0.012
    )

    local start = KasparovClock()
    local run = {
        Start = start,
        Deadline = start + timeBudget,
        BaseThinkTime = baseThinkTime,
        TimeMultiplier = multiplier,
        TimeBudget = timeBudget,
        TargetDepth = targetDepth,
        NodeLimit = nodeLimit,
        YieldEvery = yieldEvery,
        SliceTime = sliceTime,
        SliceProvider = options.SliceProvider or options.SliceTimeProvider,
        Cancel = options.Cancel,
        Nodes = 0,
        QNodes = 0,
        Visited = 0,
        YieldCount = 0,
        PeakSlice = 0,
        LastYield = start,
        CompletedDepth = 0,
        Aborted = false,
    }

    KasparovActive = run
    g_timeout = timeBudget
    g_maxfinCnt = KasparovMax(100000, KasparovMin(2147483647, nodeLimit * 8))

    local ok, failure = pcall(function()
        InitializeFromFen(fen)
        Search(targetDepth)
    end)

    if not ok then
        run.Error = tostring(failure)
    end

    local move
    if g_foundmove ~= nil and g_foundmove ~= 0 then
        move = FormatMove(g_foundmove)
    end
    local score = g_foundvalue

    if not run.Aborted and KasparovClock() >= run.Deadline then
        run.TimedOut = true
        run.AbortReason = "TimeLimit"
    end

    local stats = KasparovBuildStats(run, move, score)
    if run.Error then stats.Error = run.Error end
    KasparovActive = nil

    if run.Error then
        return nil, nil, {Error = run.Error, Stats = stats}
    end
    if not move then
        return nil, score, {NoLegalMove = true, Stats = stats}
    end
    return move, score, nil
end

