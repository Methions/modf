		local a = 1 - math.exp(-dt * 26)
		dh += (h - dh) * a
		ds += (s - ds) * a
		dv += (v - dv) * a
		if not dragMode and math.abs(dh - h) < .0008 and math.abs(ds - s) < .0008 and math.abs(dv - v) < .0008 then
			dh, ds, dv = h, s, v
			settling = false
		end
		paint()
