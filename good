local lastInsetT, inset = nil, Vector2.zero
local function mouse()
	local t = time()
	if lastInsetT ~= t then
		lastInsetT = t
		inset = GuiService:GetGuiInset()
	end
	return UIS:GetMouseLocation() - inset
end
