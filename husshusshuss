local function moveAlgebraic(m)
    local from = band(m, 127)
    local to = band(rshift(m, 7), 127)
    local promo = band(rshift(m, 14), 7)
    return squareName(from) .. squareName(to) .. (PROMO_LETTER[promo] or "")
end

