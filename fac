		pickBack.Visible, pickPanel.Visible = true, true
		pickPanel.Position = UDim2.new(.5, 0, 1, 10)
		tween(pickBack, { BackgroundTransparency = .45 }, .25)
		tween(pickPanel, { Position = UDim2.new(.5, 0, 1, -8) }, .5, SPRING)
