local Countries = {
	US = "United States", GB = "United Kingdom", DE = "Germany", FR = "France", NL = "Netherlands", SG = "Singapore",
	JP = "Japan", AU = "Australia", BR = "Brazil", IN = "India", HK = "Hong Kong", CA = "Canada",
