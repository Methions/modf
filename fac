local function makeCard(self, class, height)
	local props = {
		Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(), Parent = self.List,
