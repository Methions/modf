		}
	end

	local chip = new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 9), Size = UDim2.fromOffset(40, 24),
		BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, ClipsDescendants = true, Parent = card,
