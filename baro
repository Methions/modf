				end
				lastIndex = index
				status.Text = index > 0 and (tostring(index) .. " of " .. tostring(#options)) or "No selection"
			end
		end
	end

	if activateControl then
		activateControl.MouseButton1Click:Connect(function()
			if not actionAllowed() then return end
			front()
