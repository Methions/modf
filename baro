			cur = cur.Parent
		end
		return win.Overlay, win.Body, math.max(win.Scale.Scale, .01)
	end

	local host
	local popupFrame, popupScale
	if popup then
		popupFrame = new("Frame", {
			BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, ClipsDescendants = true, Visible = false, ZIndex = 50,
		})
