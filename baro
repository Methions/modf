	local body = new("CanvasGroup", { Name = "QuickBody", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, GroupTransparency = 1, ClipsDescendants = true, Active = true, ZIndex = 2, Parent = root })
