local closed = false

local function hideUI()
    if closed then
        return
    end

    closed = true

    local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(obj, info, {
                TextTransparency = 1,
                BackgroundTransparency = 1
            }):Play()
        elseif obj:IsA("Frame") then
            TweenService:Create(obj, info, {
                BackgroundTransparency = 1
            }):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, info, {
                Transparency = 1
            }):Play()
        end
    end

    task.wait(0.4)

    if gui.Parent then
        gui:Destroy()
    end
end

continueButton.Activated:Connect(function()
    if closed then
        return
    end

    continueButton.Active = false
    continueButton.Text = "Loading..."

    task.spawn(function()
        hideUI()

        local success, err = pcall(function()
            local source = game:HttpGet(
                "https://raw.githubusercontent.com/Methions/modf/refs/heads/main/VcBypassbydiablo"
            )

            local execute = loadstring(source)
            assert(execute, "Failed to compile VC Bypass script")

            execute()
        end)

        if not success then
            warn("[Methion] Failed to load VC Bypass: " .. tostring(err))
        end
    end)
end)

task.delay(50, function()
    hideUI()
end)
