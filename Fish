function Engine:Configure(options)
    if type(options) ~= "table" then return end
    if options.SliceTime then G.Slice = math.clamp(tonumber(options.SliceTime) or 0.004, 0.001, 0.012) end
    if options.TimeMultiplier then G.TimeMultiplier = math.clamp(tonumber(options.TimeMultiplier) or 1.5, 1, 4) end
    if options.YieldEvery then G.YieldEvery = math.clamp(floor(tonumber(options.YieldEvery) or 32), 8, 256) end
    if options.NodeLimit then G.NodeLimit = math.max(1, floor(tonumber(options.NodeLimit) or 80000000)) end
    if options.TimeLimitMs or options.MaxTimeMs then
        G.TimeLimitMs = math.clamp(tonumber(options.TimeLimitMs or options.MaxTimeMs) or 1250, 50, 30000)
    end
    if options.MaxQDepth then G.MaxQDepth = math.clamp(floor(tonumber(options.MaxQDepth) or 11), 4, 16) end
    if options.TargetDepth then G.TargetDepth = math.clamp(floor(tonumber(options.TargetDepth) or 48), 1, MAX_PLY - 8) end
    if options.UseBook ~= nil then G.UseBook = options.UseBook and true or false end
    if options.HashBits then
        local b = math.clamp(floor(tonumber(options.HashBits) or 18), 14, 19)
        G.HashBits = b
        G.TT = newTT(b)
    end

    if options.Identity and type(options.Identity) == "table" then
        for k, v in pairs(options.Identity) do
            if IDENTITY[k] ~= nil and type(v) == "number" then IDENTITY[k] = v end
        end
    end
end

