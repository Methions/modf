    local nodeLegal = false
    if type(nodeLimitedMove) == "string" then
        local root = parseFEN(START_FEN)
        local legal = generate(root, false)
        for i = 1, #legal do
            if moveAlgebraic(legal[i]) == nodeLimitedMove then nodeLegal = true; break end
        end
    end
    add("Node limit returns legal fallback", "nodes <= 400 and legal move",
        tostring(nodeStats.Nodes) .. " / " .. tostring(nodeLimitedMove),
        nodeStats.Nodes <= 400 and nodeLimitedMove ~= nil and nodeLegal)

    local timedMove = self:GetBestMoveFromFEN(START_FEN, 2, {
        TimeLimitMs = 50, TargetDepth = 20, NodeLimit = 5000000, UseBook = false,
    })
    local timeStats = self:GetStats()
    add("50 ms time limit honored", "elapsed <= 0.20 sec and legal move",
        tostring(timeStats.Time) .. " / " .. tostring(timedMove),
        timeStats.Time <= 0.20 and timedMove ~= nil)

    local cancelMove = self:GetBestMoveFromFEN(START_FEN, 0.20, {
        TimeMultiplier = 1, TargetDepth = 12, NodeLimit = 500000,
        UseBook = false, Cancel = function() return true end,
    })
    local cancelStats = self:GetStats()
    local cancelLegal = false
    if type(cancelMove) == "string" then
        local root = parseFEN(START_FEN)
        local moves = generate(root, false)
        for i = 1, #moves do if moveAlgebraic(moves[i]) == cancelMove then cancelLegal = true; break end end
    end
    add("Immediate cancellation returns legal fallback", "Cancelled + legal move",
        tostring(cancelMove) .. " / " .. tostring(cancelStats.Cancelled),
        cancelStats.Cancelled == true and cancelLegal)

    return {Passed = passed, Total = #results, Results = results}
end

function Engine:ClearCache()
    G.HashBits = mmax(14, mmin(19, floor(tonumber(G.HashBits) or 18)))
    G.TT = newTT(G.HashBits)
    G.History = {}
    G.CaptureHistory = {}
end

function Engine:Perft(fen, depth)
    local E = parseFEN(fen or START_FEN)
    if not E or not E.valid then return nil end
    depth = tonumber(depth or 3)
    if not depth or depth < 0 or depth > 10 or depth ~= floor(depth) then return nil end
    local function perft(d, ply)
        if d == 0 then return 1 end
        local moves = generate(E, false)
        local total = 0
        for i = 1, #moves do
            if makeMove(E, moves[i], ply) then
                total = total + perft(d - 1, ply + 1)
                unmakeMove(E, moves[i], ply)
            end
        end
        return total
    end
    return perft(depth, 0)
end

function Engine:GetPV(fen, maxPly)
    local E = parseFEN(fen)
    if not E or not E.valid then return "" end
    maxPly = math.clamp(floor(tonumber(maxPly) or 30), 1, MAX_PLY - 8)
    local out = {}
    local seen = {}
    local tt = G.TT
    for i = 1, maxPly do
        local key1, key2 = ttKeys(E)
        local idx = band(key1, tt.mask) + 1
        if tt.k1[idx] ~= key1 or tt.k2[idx] ~= key2 or tt.mv[idx] == 0 then break end
        local m = tt.mv[idx]
        local key = tostring(E.h1) .. ":" .. tostring(m)
        if seen[key] then break end
        seen[key] = true
        local ok = false
        local list = generate(E, false)
        for j = 1, #list do
            if list[j] == m then ok = makeMove(E, m, i); break end
        end
        if not ok then break end
        out[#out + 1] = moveAlgebraic(m)
    end
    return table.concat(out, " ")
end

function Engine:GetBestMoveFromFEN(fen, thinkTime, options)
    if type(fen) ~= "string" or fen == "" then return nil end
    options = type(options) == "table" and options or {}
    local baseThinkTime = math.clamp(tonumber(thinkTime) or 1.25, 0.05, 30)
    local timeMultiplier = math.clamp(tonumber(options.TimeMultiplier) or G.TimeMultiplier or 1.0, 1, 4)
    local requested = math.clamp(baseThinkTime * timeMultiplier, 0.05, 30)
    local directLimitMs = tonumber(options.TimeLimitMs or options.MaxTimeMs or G.TimeLimitMs)
    if directLimitMs then requested = math.clamp(directLimitMs / 1000, 0.05, 30) end

    G.SearchId = G.SearchId + 1
    local E = parseFEN(fen)
    if not E or not E.valid then return nil, nil, nil end
    local start = clock()
    E.deadline = start + requested
    E.nodeLimit = mmax(1, floor(tonumber(options.NodeLimit) or G.NodeLimit or 80000000))
    E.maxQDepth = math.clamp(floor(tonumber(options.MaxQDepth) or G.MaxQDepth or 11), 4, 16)
    E.slice = math.clamp(tonumber(options.SliceTime) or G.Slice or 0.004, 0.001, 0.012)
    E.yieldEvery = math.clamp(floor(tonumber(options.YieldEvery) or G.YieldEvery or 32), 8, 256)
    E.sliceProvider = type(options.SliceTimeProvider) == "function" and options.SliceTimeProvider or nil
    E.cancel = type(options.Cancel) == "function" and options.Cancel or nil
    E.cancelled = false
    if E.cancel then
        local cancelOk, cancelNow = pcall(E.cancel)
        if not cancelOk or cancelNow then E.cancelled = true end
    end
    E.yieldCount = 0
    E.peakSlice = 0
    E.tt = G.TT
    E.lastYield = start

    for k, v in pairs(G.History) do G.History[k] = floor(v / 2) end
    for k, v in pairs(G.CaptureHistory) do G.CaptureHistory[k] = floor(v / 2) end
    E.history = G.History
    E.captureHistory = G.CaptureHistory

    -- FEN has no previous-move history. Callers supply prior positions in
    -- chronological order (FEN strings) so threefold detection is genuine.
    if type(options.History) == "table" and #options.History > 0 then
        local r1, r2 = {}, {}
        for _, hf in ipairs(options.History) do
            if type(hf) == "string" then
                local P = parseFEN(hf)
                if P and P.valid then
                    r1[#r1 + 1], r2[#r2 + 1] = P.h1, P.h2
                end
            end
        end
        r1[#r1 + 1], r2[#r2 + 1] = E.h1, E.h2
        E.rep1, E.rep2, E.repN = r1, r2, #r1
    end

    local pseudo = generate(E, false)
    local rscores = {}
    for i = 1, #pseudo do rscores[i] = moveScore(E, pseudo[i], 0, 0) end
    for i = 1, #pseudo do pick(pseudo, rscores, i, #pseudo) end
    local list = {}
    for i = 1, #pseudo do
        if makeMove(E, pseudo[i], 0) then
            unmakeMove(E, pseudo[i], 0)
            list[#list + 1] = {m = pseudo[i], score = 0}
        end
    end
    E.root = list

    local rootChecked = inCheck(E, E.side)
    if #list == 0 then
        local terminal = rootChecked and "checkmate" or "stalemate"
        G.LastStats = {
            Name = self.Name, Version = self.Version, Depth = 0, Nodes = 0, QNodes = 0,
            TTHits = 0, TTCutoffs = 0, Time = clock() - start, TimeBudget = requested,
            Score = rootChecked and -MATE or 0, Move = nil, PV = "", Terminal = terminal,
        }
        return nil, rootChecked and -MATE or 0, nil
    end
    if insufficientMaterial(E) or E.half >= 100 or isRepetition(E) then
        local terminal = insufficientMaterial(E) and "insufficient_material"
            or (E.half >= 100 and "fifty_move_rule" or "threefold_repetition")
        G.LastStats = {
            Name = self.Name, Version = self.Version, Depth = 0, Nodes = 0, QNodes = 0,
            TTHits = 0, TTCutoffs = 0, Time = clock() - start, TimeBudget = requested,
            Score = 0, Move = nil, PV = "", Terminal = terminal,
        }
        return nil, 0, nil
    end

    local function finish(move, score, depth, pv, reaction)
        local elapsed = clock() - start
        G.LastStats = {
            Name = self.Name, Version = self.Version, Style = self.Style,
            Depth = depth, FullMoves = floor(depth / 2), TargetDepth = E.targetDepth or depth,
            Nodes = E.nodes, QNodes = E.qnodes,
            TTHits = E.ttHits or 0, TTCutoffs = E.ttCutoffs or 0,
            Time = elapsed, BaseThinkTime = baseThinkTime, TimeMultiplier = timeMultiplier,
            TimeBudget = requested, NPS = floor(E.nodes / mmax(elapsed, 1e-3)), Score = score,
            YieldCount = E.yieldCount or 0,
            PeakSliceMs = floor((E.peakSlice or 0) * 1000 + 0.5),
            Cancelled = E.cancelled == true,
            Move = move and moveAlgebraic(move) or nil, PV = pv or "",
        }
        return moveAlgebraic(move), score, reaction
    end

    local useBook = options.UseBook
    if useBook == nil then useBook = G.UseBook == true end
    if useBook and #list > 1 and E.half < 50 then
        G.Book = G.Book or buildBook()
        local entry = G.Book[tostring(E.h1) .. ":" .. tostring(E.h2)]
        if entry then
            local total, choices = 0, {}
            for tok, w in pairs(entry) do
                for i = 1, #list do
                    if moveAlgebraic(list[i].m) == tok then
                        choices[#choices + 1] = {m = list[i].m, w = w}
                        total = total + w
                        break
                    end
                end
            end
            if total > 0 then
                local roll = math.random() * total
                for i = 1, #choices do
                    roll = roll - choices[i].w
                    if roll <= 0 or i == #choices then
                        return finish(choices[i].m, 0, 0, moveAlgebraic(choices[i].m),
                            {notify = false, tag = "BOOK", message = "Sharp opening theory -- on with the hunt.", icon = "book-open"})
                    end
                end
            end
        end
    end

    if #list == 1 then
        local s = evaluate(E)
        return finish(list[1].m, s, 0, moveAlgebraic(list[1].m), nil)
    end

    local bestMove = list[1].m
    local bestScore = insufficientMaterial(E) and 0 or evaluate(E)
    local previousScore, completedDepth = bestScore, 0
    -- Reuse a legal root TT move as the first candidate when it exists.
    do
        local k1, k2 = ttKeys(E)
        local ti = band(k1, E.tt.mask) + 1
        if E.tt.k1[ti] == k1 and E.tt.k2[ti] == k2 and E.tt.mv[ti] ~= 0 then
            for i = 1, #list do
                if list[i].m == E.tt.mv[ti] then
                    list[1], list[i] = list[i], list[1]
                    bestMove = list[1].m
                    break
                end
            end
        end
    end
    local maxDepth = math.clamp(floor(tonumber(options.TargetDepth or options.MaxDepth or options.Depth or G.TargetDepth or self.TargetDepth) or 48), 1, MAX_PLY - 8)
    E.targetDepth = maxDepth
    local softLimit = start + requested * 0.97
    local depth = 1

    while depth <= maxDepth do
        if depth > 1 and clock() >= softLimit then break end
        E.abort = false
        local alpha, beta = -INF, INF
        local delta = 30
        if depth >= 5 and abs(previousScore) < MATE - 1000 then
            alpha, beta = previousScore - delta, previousScore + delta
        end
        local m, score, complete
        local done = false
        while true do
            m, score, complete = rootSearch(E, depth, alpha, beta)
            if not complete then break end
            if score <= alpha and alpha > -INF then
                if delta >= 300 or abs(score) > MATE - 1000 then alpha = -INF else alpha = score - delta end
                delta = delta * 2
            elseif score >= beta and beta < INF then
                if delta >= 300 or abs(score) > MATE - 1000 then beta = INF else beta = score + delta end
                delta = delta * 2
            else
                done = true
                break
            end
        end

        if done then
            bestMove, bestScore = m, score
            previousScore = score
            completedDepth = depth
            for i = 2, #list do
                local j = i
                while j > 1 and list[j].score > list[j - 1].score do
                    list[j], list[j - 1] = list[j - 1], list[j]
                    j = j - 1
                end
            end
            ttStore(E, depth, score, 0, m, 0)
            if score > MATE - 1000 and (MATE - score) <= depth then break end
        else
            break
        end
        depth = depth + 1
        yield()
        E.yieldCount = (E.yieldCount or 0) + 1
        E.lastYield = clock()
    end

    local pv = self:GetPV(fen, mmin(30, mmax(1, completedDepth)))
    local reaction
    if bestScore >= MATE - 2000 then
        reaction = {notify = true, tag = "MATE", message = "The king hunt ends here.", icon = "swords"}
    elseif bestScore <= -MATE + 2000 then
        reaction = {notify = true, tag = "DANGER", message = "The position holds a forced tactical blow against us.", icon = "triangle-alert"}
    elseif E.nodes > 50000 and completedDepth >= 6 then
        reaction = {notify = false, tag = "DEEP", message = "Deep calculation complete.", icon = "scan-search"}
    end
    return finish(bestMove, bestScore, completedDepth, pv, reaction)
end

function Engine:GetPremoveFromFEN(fen, thinkTime, options)
    if type(fen) ~= "string" or fen == "" then return nil end

    local fields = {}
    for part in string.gmatch(fen, "%S+") do fields[#fields + 1] = part end
    if fields[2] ~= "w" and fields[2] ~= "b" then return nil end

    options = type(options) == "table" and options or {}
    local requested = math.clamp(tonumber(thinkTime) or 0.9, 0.2, 4)
    local searchOptions = {}
    for key, value in pairs(options) do searchOptions[key] = value end
    searchOptions.UseBook = false
    local premoveDepth = math.clamp(floor(tonumber(options.TargetDepth or options.MaxDepth) or 16), 1, 30)
    searchOptions.TargetDepth = premoveDepth
    searchOptions.MaxDepth = premoveDepth
    searchOptions.NodeLimit = floor(tonumber(options.NodeLimit) or 3000000)

    local start = clock()
    local opponentMove = self:GetBestMoveFromFEN(
        fen,
        math.max(0.1, requested * 0.42),
        searchOptions
    )
    if type(opponentMove) ~= "string" or not opponentMove:match("^[a-h][1-8][a-h][1-8][qrbn]?$") then
        return nil
    end

    if type(searchOptions.Cancel) == "function" and searchOptions.Cancel() then
        return nil
    end

    local position = parseFEN(fen)
    if not position or not position.valid then return nil end
    local matchingMove
    local legal = generate(position, false)
    for i = 1, #legal do
        if moveAlgebraic(legal[i]) == opponentMove and makeMove(position, legal[i], 0) then
            matchingMove = legal[i]
            break
        end
    end
    if not matchingMove then return nil end

    local fullmove = tonumber(fields[6]) or 1
    if position.side == WHITE then fullmove = fullmove + 1 end
    local replyFen = positionToFEN(position, fullmove)

    if type(searchOptions.Cancel) == "function" and searchOptions.Cancel() then
        return nil
    end

    local remaining = requested - (clock() - start)
    local responseTime = math.clamp(remaining, 0.1, math.max(0.1, requested * 0.65))
    local premove, score, reaction = self:GetBestMoveFromFEN(
        replyFen,
        responseTime,
        searchOptions
    )
    if type(premove) ~= "string" or not premove:match("^[a-h][1-8][a-h][1-8][qrbn]?$") then
        return nil
    end

    if type(searchOptions.Cancel) == "function" and searchOptions.Cancel() then
        return nil
    end

    return {
        OpponentMove = opponentMove,
        Move = premove,
        Score = score,
        Reaction = reaction,
        SourceFEN = fen,
        ReplyFEN = replyFen,
        Elapsed = clock() - start,
        PV = G.LastStats and G.LastStats.PV or "",
    }
end

function Engine:Analyze(fen, thinkTime, options)
    local move, score, reaction = self:GetBestMoveFromFEN(fen, thinkTime, options)
    return {Move = move, Score = score, Reaction = reaction, Stats = G.LastStats,
        PV = G.LastStats and G.LastStats.PV or "", Terminal = G.LastStats and G.LastStats.Terminal or nil}
end

