isAttacked = function(E, s, by)
    local B = E.board
    if by == WHITE then
        local a = s - 15
        if ON[a + 64] and B[a] == PAWN then return true end
        a = s - 17
        if ON[a + 64] and B[a] == PAWN then return true end
    else
        local a = s + 15
        if ON[a + 64] and B[a] == -PAWN then return true end
        a = s + 17
        if ON[a + 64] and B[a] == -PAWN then return true end
    end
    local kn = by * KNIGHT
    local knightSources = G.AttackTables.KnightTo[s] or {}
    for i = 1, #knightSources do
        if B[knightSources[i]] == kn then return true end
    end
    local bi, qu, ro, ki = by * BISHOP, by * QUEEN, by * ROOK, by * KING
    for i = 1, 4 do
        local d = BISHOP_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == bi or p == qu then return true end
                break
            end
            t = t + d
        end
    end
    for i = 1, 4 do
        local d = ROOK_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == ro or p == qu then return true end
                break
            end
            t = t + d
        end
    end
    for i = 1, 8 do
        local t = s + KING_D[i]
        if ON[t + 64] and B[t] == ki then return true end
    end
    return false
end

local function inCheck(E, side)
    local k = side == WHITE and E.kingW or E.kingB
    return isAttacked(E, k, -side)
end

local function nearestAttacker(B, s, by)
    local best, bestValue = -1, INF
    local function consider(from)
        local p = B[from]
        if p ~= 0 and p * by > 0 then
            local v = VAL[abs(p)]
            if v < bestValue then best, bestValue = from, v end
        end
    end

    if by == WHITE then
        local a = s - 15
        if ON[a + 64] and B[a] == PAWN then consider(a) end
        a = s - 17
        if ON[a + 64] and B[a] == PAWN then consider(a) end
    else
        local a = s + 15
        if ON[a + 64] and B[a] == -PAWN then consider(a) end
        a = s + 17
        if ON[a + 64] and B[a] == -PAWN then consider(a) end
    end

    local kn = by * KNIGHT
    local knightSources = G.AttackTables.KnightTo[s] or {}
    for i = 1, #knightSources do
        local t = knightSources[i]
        if B[t] == kn then consider(t) end
    end

    for i = 1, 4 do
        local d = BISHOP_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == by * BISHOP or p == by * QUEEN then consider(t) end
                break
            end
            t = t + d
        end
    end

    for i = 1, 4 do
        local d = ROOK_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == by * ROOK or p == by * QUEEN then consider(t) end
                break
            end
            t = t + d
        end
    end

    local king = by * KING
    local kingSources = G.AttackTables.KingTo[s] or {}
    for i = 1, #kingSources do
        local t = kingSources[i]
        if B[t] == king then consider(t) end
    end
    return best
end

local function generate(E, capsOnly)
    local B = E.board
    local moves, n = {}, 0
    local side = E.side
    local enemy = -side
    local ep = E.ep
    local step = side * 16
    local startRank = side == WHITE and 1 or 6
    local promoRank = side == WHITE and 7 or 0

    for r = 0, 7 do
        local base = r * 16
        for f = 0, 7 do
            local s = base + f
            local p = B[s]
            if p * side > 0 then
                local t = p > 0 and p or -p
                if t == PAWN then
                    local one = s + step
                    if B[one] == 0 then
                        if rshift(one, 4) == promoRank then
                            for i = 1, 4 do n = n + 1; moves[n] = encMove(s, one, PROMOS[i], 0) end
                        elseif not capsOnly then
                            n = n + 1; moves[n] = encMove(s, one, 0, 0)
                            if r == startRank then
                                local two = one + step
                                if B[two] == 0 then n = n + 1; moves[n] = encMove(s, two, 0, FLAG_DOUBLE) end
                            end
                        end
                    end
                    for k = -1, 1, 2 do
                        local c = one + k
                        if ON[c + 64] then
                            local q = B[c]
                            if q * side < 0 then
                                if rshift(c, 4) == promoRank then
                                    for i = 1, 4 do n = n + 1; moves[n] = encMove(s, c, PROMOS[i], FLAG_CAPTURE) end
                                else
                                    n = n + 1; moves[n] = encMove(s, c, 0, FLAG_CAPTURE)
                                end
                            elseif q == 0 and c == ep then
                                n = n + 1; moves[n] = encMove(s, c, 0, FLAG_CAPTURE + FLAG_EP)
                            end
                        end
                    end
                elseif t == KNIGHT then
                    local targets = G.AttackTables.KnightTo[s]
                    for i = 1, #targets do
                        local to = targets[i]
                        local q = B[to]
                        if q == 0 then
                            if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                        elseif q * side < 0 then
                            n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE)
                        end
                    end
                elseif t == KING then
                    local targets = G.AttackTables.KingTo[s]
                    for i = 1, #targets do
                        local to = targets[i]
                        local q = B[to]
                        if q == 0 then
                            if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                        elseif q * side < 0 then
                            n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE)
                        end
                    end
                    local cr = E.castle
                    if not capsOnly and cr ~= 0 then
                        if side == WHITE and s == 4 then
                            if band(cr, 1) ~= 0 and B[5] == 0 and B[6] == 0 and B[7] == ROOK
                                and not isAttacked(E, 4, enemy) and not isAttacked(E, 5, enemy) and not isAttacked(E, 6, enemy) then
                                n = n + 1; moves[n] = encMove(4, 6, 0, FLAG_CASTLE)
                            end
                            if band(cr, 2) ~= 0 and B[3] == 0 and B[2] == 0 and B[1] == 0 and B[0] == ROOK
                                and not isAttacked(E, 4, enemy) and not isAttacked(E, 3, enemy) and not isAttacked(E, 2, enemy) then
                                n = n + 1; moves[n] = encMove(4, 2, 0, FLAG_CASTLE)
                            end
                        elseif side == BLACK and s == 116 then
                            if band(cr, 4) ~= 0 and B[117] == 0 and B[118] == 0 and B[119] == -ROOK
                                and not isAttacked(E, 116, enemy) and not isAttacked(E, 117, enemy) and not isAttacked(E, 118, enemy) then
                                n = n + 1; moves[n] = encMove(116, 118, 0, FLAG_CASTLE)
                            end
                            if band(cr, 8) ~= 0 and B[115] == 0 and B[114] == 0 and B[113] == 0 and B[112] == -ROOK
                                and not isAttacked(E, 116, enemy) and not isAttacked(E, 115, enemy) and not isAttacked(E, 114, enemy) then
                                n = n + 1; moves[n] = encMove(116, 114, 0, FLAG_CASTLE)
                            end
                        end
                    end
                else
                    local deltas = (t == BISHOP) and BISHOP_D or (t == ROOK) and ROOK_D or KING_D
                    local stop = (t == QUEEN) and 8 or 4
                    for i = 1, stop do
                        local d = deltas[i]
                        local to = s + d
                        while ON[to + 64] do
                            local q = B[to]
                            if q == 0 then
                                if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                            else
                                if q * side < 0 then n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE) end
                                break
                            end
                            to = to + d
                        end
                    end
                end
            end
        end
    end
    return moves
end

local function restore(E, S)
    local B = E.board
    local rf = S.rookFrom
    if rf then
        B[rf] = B[S.rookTo]
        B[S.rookTo] = 0
    end
    B[S.to] = 0
    B[S.capSq] = S.captured
    B[S.from] = S.piece
    E.castle = S.castle
    E.ep = S.ep
    E.half = S.half
    E.h1 = S.h1
    E.h2 = S.h2
    E.mg = S.mg
    E.eg = S.eg
    E.phase = S.phase
    E.npmW = S.npmW
    E.npmB = S.npmB
    E.kingW = S.kingW
    E.kingB = S.kingB
    E.side = S.side
end

local function makeMove(E, m, ply)
    local B = E.board
    local from = band(m, 127)
    local to = band(rshift(m, 7), 127)
    local promo = band(rshift(m, 14), 7)
    local flags = band(rshift(m, 17), 15)
    local piece = B[from]
    if piece == 0 then return false end
    local mover = E.side
    if piece * mover <= 0 or (B[to] or 0) * mover > 0 then return false end
    local capSq = to
    if band(flags, FLAG_EP) ~= 0 then
        capSq = to - mover * 16
        if B[to] ~= 0 or B[capSq] ~= -mover * PAWN then return false end
    end
    local captured = B[capSq] or 0
    if captured == -mover * KING then return false end
    if band(flags, FLAG_CAPTURE) ~= 0 and captured == 0 then return false end
    if band(flags, FLAG_CAPTURE) == 0 and captured ~= 0 then return false end

    local S = E.stack[ply]
    if not S then S = {}; E.stack[ply] = S end
    S.from, S.to, S.piece, S.captured, S.capSq = from, to, piece, captured, capSq
    S.castle, S.ep, S.half, S.h1, S.h2 = E.castle, E.ep, E.half, E.h1, E.h2
    S.mg, S.eg, S.phase, S.npmW, S.npmB = E.mg, E.eg, E.phase, E.npmW, E.npmB
    S.kingW, S.kingB, S.side = E.kingW, E.kingB, E.side
    S.rookFrom, S.rookTo = nil, nil

    local h1, h2 = E.h1, E.h2
    local ep = E.ep
    if ep >= 0 and epCapturable(B, ep, mover, mover == WHITE and E.kingW or E.kingB) then
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    end
    local c = E.castle
    h1 = bxor(h1, ZC1[c + 1]); h2 = bxor(h2, ZC2[c + 1])

    local mg, eg = E.mg, E.eg
    local pi = piece + 7
    h1 = bxor(h1, ZP1[pi][from + 1]); h2 = bxor(h2, ZP2[pi][from + 1])
    mg = mg - MGT[pi][from]; eg = eg - EGT[pi][from]

    if captured ~= 0 then
        local ci = captured + 7
        h1 = bxor(h1, ZP1[ci][capSq + 1]); h2 = bxor(h2, ZP2[ci][capSq + 1])
        mg = mg - MGT[ci][capSq]; eg = eg - EGT[ci][capSq]
        local ac = captured > 0 and captured or -captured
        E.phase = E.phase - PHASE_W[ac]
        if ac ~= PAWN then
            if captured > 0 then E.npmW = E.npmW - VAL[ac] else E.npmB = E.npmB - VAL[ac] end
        end
        B[capSq] = 0
    end
    B[from] = 0

    local placed = piece
    if promo ~= 0 then
        placed = mover * promo
        E.phase = E.phase + PHASE_W[promo]
        if mover == WHITE then E.npmW = E.npmW + VAL[promo] else E.npmB = E.npmB + VAL[promo] end
    end
    B[to] = placed
    local pli = placed + 7
    h1 = bxor(h1, ZP1[pli][to + 1]); h2 = bxor(h2, ZP2[pli][to + 1])
    mg = mg + MGT[pli][to]; eg = eg + EGT[pli][to]

    if piece == KING then E.kingW = to elseif piece == -KING then E.kingB = to end

    if band(flags, FLAG_CASTLE) ~= 0 then
        local rf, rt
        if to == 6 then rf, rt = 7, 5
        elseif to == 2 then rf, rt = 0, 3
        elseif to == 118 then rf, rt = 119, 117
        else rf, rt = 112, 115 end
        local rook = B[rf]
        B[rf] = 0
        B[rt] = rook
        S.rookFrom, S.rookTo = rf, rt
        local ri = rook + 7
        h1 = bxor(h1, ZP1[ri][rf + 1]); h1 = bxor(h1, ZP1[ri][rt + 1])
        h2 = bxor(h2, ZP2[ri][rf + 1]); h2 = bxor(h2, ZP2[ri][rt + 1])
        mg = mg - MGT[ri][rf] + MGT[ri][rt]
        eg = eg - EGT[ri][rf] + EGT[ri][rt]
    end

    c = band(c, CASTLE_CLEAR[from], CASTLE_CLEAR[to])
    E.castle = c
    h1 = bxor(h1, ZC1[c + 1]); h2 = bxor(h2, ZC2[c + 1])

    if band(flags, FLAG_DOUBLE) ~= 0 then
        ep = rshift(from + to, 1)
    else
        ep = -1
    end
    E.ep = ep
    if ep >= 0 and epCapturable(B, ep, -mover, -mover == WHITE and E.kingW or E.kingB) then
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    end
    h1 = bxor(h1, ZS1); h2 = bxor(h2, ZS2)

    if piece == PAWN or piece == -PAWN or captured ~= 0 then E.half = 0 else E.half = E.half + 1 end
    E.mg, E.eg = mg, eg
    E.h1, E.h2 = h1, h2
    E.side = -mover

    local ks = (mover == WHITE) and E.kingW or E.kingB
    if isAttacked(E, ks, -mover) then
        restore(E, S)
        return false
    end
    local n = E.repN + 1
    E.repN = n
    E.rep1[n], E.rep2[n] = h1, h2
    return true
end

local function unmakeMove(E, m, ply)
    restore(E, E.stack[ply])
    E.repN = E.repN - 1
end

local seeGain, seeSq, seeOld = {}, {}, {}
local function see(E, m)
    local B = E.board
    local from, to = band(m, 127), band(rshift(m, 7), 127)
    local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
    local moving = B[from]
    if moving == 0 then return 0 end

    local side = moving > 0 and WHITE or BLACK
    local capSq = band(flags, FLAG_EP) ~= 0 and (to - side * 16) or to
    local captured = B[capSq]
    local gain0 = captured ~= 0 and VAL[abs(captured)] or 0
    if promo ~= 0 then gain0 = gain0 + VAL[promo] - VAL[PAWN] end
    if gain0 == 0 and promo == 0 then return 0 end

    local oldFrom, oldTo, oldCap = B[from], B[to], B[capSq]
    local placed = promo ~= 0 and side * promo or moving
    B[from] = 0
    if capSq ~= to then B[capSq] = 0 end
    B[to] = placed

    seeGain[1] = gain0
    local depth, occupantValue, changed = 0, VAL[abs(placed)], 0
    side = -side
    while depth < 30 do
        local attacker = nearestAttacker(B, to, side)
        if attacker < 0 then break end
        depth = depth + 1
        seeGain[depth + 1] = occupantValue - seeGain[depth]
        if mmax(-seeGain[depth], seeGain[depth + 1]) < 0 then
            depth = depth - 1
            break
        end
        local p = B[attacker]
        local promoted = abs(p) == PAWN and rshift(to, 4) == (side == WHITE and 7 or 0)
        changed = changed + 1
        seeSq[changed], seeOld[changed] = attacker, p
        B[attacker] = 0
        B[to] = promoted and side * QUEEN or p
        if promoted then
            seeGain[depth + 1] = seeGain[depth + 1] + VAL[QUEEN] - VAL[PAWN]
        end
        occupantValue = promoted and VAL[QUEEN] or VAL[abs(p)]
        side = -side
    end

    while depth > 0 do
        seeGain[depth] = -mmax(-seeGain[depth], seeGain[depth + 1])
        depth = depth - 1
    end

    for i = changed, 1, -1 do B[seeSq[i]] = seeOld[i] end
    B[from], B[to] = oldFrom, oldTo
    if capSq ~= to then B[capSq] = oldCap end
    return seeGain[1]
end

local FORK_UNIT  = {0, 10, 34, 38, 55, 78, 0}
local PIN_UNIT   = {0, 0, 24, 26, 34, 46, 0}
local HANG_FRAC  = 0.34
local CHECK_MULT = 46

local function pieceIsLoose(E, sq, pieceSide)
    local B = E.board
    local atk = nearestAttacker(B, sq, -pieceSide)
    if atk < 0 then return false end
    local def = nearestAttacker(B, sq, pieceSide)
    local attackerVal = VAL[abs(B[atk])]
    local pieceVal = VAL[abs(B[sq])]
    if def < 0 then return true end
    return attackerVal < pieceVal
end

local IDENTITY = {
    Att = 1.16,
    Safe = 1.08,
    Mob = 1.08,
    Pwn = 1.05,
    Tac = 1.16,
    Contempt = 12,
    Center = 9,
    LMR = 0.78,
}
G.Identity = IDENTITY

local PASS_MG = {0, 6, 12, 22, 38, 64, 108, 0}
local PASS_EG = {0, 10, 20, 42, 74, 126, 198, 0}
local THREAT  = {0, 26, 26, 46, 64, 0}
local ATK_MULT   = {0, 0, 50, 75, 88, 94, 97, 99, 100}
local FLIGHT_MULT = {170, 142, 120, 106, 100, 100, 100, 100, 100}
local TEMPO = 12
local LAZY  = 1400

local fileW, fileB, maxRB, minRW = {}, {}, {}, {}
local LW = {{}, {}, {}, {}, {}, {}}
local LB = {{}, {}, {}, {}, {}, {}}
local CW = {0, 0, 0, 0, 0, 0}
local CB = {0, 0, 0, 0, 0, 0}
local pAtkW, pAtkB, zoneW, zoneB = {}, {}, {}, {}
local evalStamp = 0

local function kdist(a, b)
    local dr = abs(rshift(a, 4) - rshift(b, 4))
    local df = abs(band(a, 15) - band(b, 15))
    return dr > df and dr or df
end

local function kingFlightSquares(E, kingSq, kingSide)
    local B = E.board
    local enemy = -kingSide
    local n = 0
    for i = 1, 8 do
        local t = kingSq + KING_D[i]
        if ON[t + 64] then
            local q = B[t]
            if q * kingSide <= 0 and not isAttacked(E, t, enemy) then n = n + 1 end
        end
    end
    return n
end

local function hangingTerm(E)
    local score = 0
    for t = 2, 5 do
        for i = 1, CW[t] do
            local s = LW[t][i]
            if pieceIsLoose(E, s, WHITE) then score = score - floor(VAL[t] * HANG_FRAC) end
        end
        for i = 1, CB[t] do
            local s = LB[t][i]
            if pieceIsLoose(E, s, BLACK) then score = score + floor(VAL[t] * HANG_FRAC) end
        end
    end
    return score
end

local function evalSide(E, B, side, L, C, ownFile, enExt, pAtkEn, zoneEn, stamp, ownK, enK, st)
    local mg, eg, aw, an = 0, 0, 0, 0
    local mob, pw, safe, tac = st.Mob, st.Pwn, st.Safe, st.Tac
    local pawn = side * PAWN
    local fwd = side * 16
    local enemyKingFile = band(enK, 15)

    for i = 1, C[1] do
        local s = L[1][i]
        local f, r = band(s, 15), rshift(s, 4)
        local fi = f + 2
        local rr = (side == WHITE) and r or 7 - r
        if ownFile[fi - 1] == 0 and ownFile[fi + 1] == 0 then
            mg = mg - 10 * pw; eg = eg - 16 * pw
        end
        local passed
        if side == WHITE then
            passed = enExt[fi - 1] <= r and enExt[fi] <= r and enExt[fi + 1] <= r
        else
            passed = enExt[fi - 1] >= r and enExt[fi] >= r and enExt[fi + 1] >= r
        end
        if passed then
            local bm, be = PASS_MG[rr + 1], PASS_EG[rr + 1]
            local pathClear, path = true, s + fwd
            while ON[path + 64] do
                if B[path] ~= 0 then pathClear = false; break end
                path = path + fwd
            end
            if not pathClear then bm = bm * 0.55; be = be * 0.55 end

            local promotionSq = (side == WHITE) and (112 + f) or f
            local steps = 7 - rr
            local enemyDistance = kdist(enK, promotionSq)
            local ownDistance = kdist(ownK, s)
            local enemyTempo = (E.side == side) and 1 or 0
            if pathClear and enemyDistance <= steps - enemyTempo then
                bm = bm * 0.5
                be = be * 0.25
            elseif pathClear then
                be = be + mmax(0, enemyDistance - steps) * 5
            end
            if ownDistance <= 2 then be = be + 10 end

            -- A rook behind its own passed pawn is a classical endgame asset;
            -- an enemy rook behind the runner counteracts part of that value.
            local behind = s - fwd
            while ON[behind + 64] do
                local q = B[behind]
                if q ~= 0 then
                    if q == side * ROOK then
                        bm = bm + 10; be = be + 18
                    elseif q == -side * ROOK then
                        bm = bm - 6; be = be - 12
                    end
                    break
                end
                behind = behind - fwd
            end
            if rr >= 2 then
                be = be + (kdist(enK, s + fwd) * 4 - kdist(ownK, s + fwd) * 2) * rr * 0.5
            end
            mg = mg + bm * pw; eg = eg + be * pw
        end
        if B[s - fwd - 1] == pawn or B[s - fwd + 1] == pawn or B[s - 1] == pawn or B[s + 1] == pawn then
            mg = mg + (3 + rr * 2) * pw
            eg = eg + (5 + rr * 3) * pw
        end

        if rr >= 3 and abs(f - enemyKingFile) <= 1 then
            mg = mg + (rr - 2) * 9 * tac
        end
        for k = -1, 1, 2 do
            local t = s + fwd + k
            if ON[t + 64] then
                local q = B[t]
                if q * side < 0 then
                    local a = q > 0 and q or -q
                    if a > 1 and a < 6 then mg = mg + THREAT[a]; eg = eg + THREAT[a] end
                end
            end
        end
    end
    for fi = 2, 9 do
        local c = ownFile[fi]
        if c > 1 then
            mg = mg - (c - 1) * 10 * pw
            eg = eg - (c - 1) * 22 * pw
        end
    end

    for i = 1, C[2] do
        local s = L[2][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 8 do
            local t = s + KNIGHT_D[k]
            if ON[t + 64] then
                local q = B[t]
                if q * side <= 0 and pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                if zoneEn[t] == stamp then hit = true end
                if q * side < 0 then
                    forkHits = forkHits + 1
                    forkVal = forkVal + FORK_UNIT[abs(q)]
                end
            end
        end
        mg = mg + (cnt - 4) * 4 * mob
        eg = eg + (cnt - 4) * 4 * mob
        if hit then aw = aw + 20; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
        local rr = (side == WHITE) and rshift(s, 4) or 7 - rshift(s, 4)
        local supported = B[s - fwd - 1] == pawn or B[s - fwd + 1] == pawn
        local enemyPawn = -side * PAWN
        local challenged = B[s + side * 16 - 1] == enemyPawn or B[s + side * 16 + 1] == enemyPawn
        if rr >= 4 and supported and not challenged then
            mg = mg + 20 * tac
            eg = eg + 12 * tac
            local f = band(s, 15)
            if f >= 2 and f <= 5 then mg = mg + 8 * tac end
        elseif rr >= 3 and supported then
            mg = mg + 8 * tac
        end
    end

    for i = 1, C[3] do
        local s = L[3][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 4 do
            local d = BISHOP_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[BISHOP] * 1.6 * tac; eg = eg + PIN_UNIT[BISHOP] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[BISHOP] * tac; eg = eg + PIN_UNIT[BISHOP] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 5) * 5 * mob
        eg = eg + (cnt - 5) * 5 * mob
        if hit then aw = aw + 20; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
    end
    if C[3] >= 2 then mg = mg + 32; eg = eg + 52 end

    for i = 1, C[4] do
        local s = L[4][i]
        local f, r = band(s, 15), rshift(s, 4)
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 4 do
            local d = ROOK_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[ROOK] * 1.6 * tac; eg = eg + PIN_UNIT[ROOK] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[ROOK] * tac; eg = eg + PIN_UNIT[ROOK] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 5) * 2 * mob
        eg = eg + (cnt - 5) * 4 * mob
        if hit then aw = aw + 40; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
        if ownFile[f + 2] == 0 then
            if enExt == maxRB then
                if maxRB[f + 2] < 0 then mg = mg + 24; eg = eg + 14 else mg = mg + 11; eg = eg + 8 end
            else
                if minRW[f + 2] > 7 then mg = mg + 24; eg = eg + 14 else mg = mg + 11; eg = eg + 8 end
            end
        end
        local rr = (side == WHITE) and r or 7 - r
        if rr == 6 then mg = mg + 10; eg = eg + 22 end

        local connected = false
        for k = 1, 4 do
            local d = ROOK_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if q ~= 0 then
                    if q == side * ROOK then connected = true end
                    break
                end
                t = t + d
            end
            if connected then break end
        end
        if connected then mg = mg + 12; eg = eg + 18 end
    end

    for i = 1, C[5] do
        local s = L[5][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 8 do
            local d = KING_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[QUEEN] * 1.6 * tac; eg = eg + PIN_UNIT[QUEEN] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[QUEEN] * tac; eg = eg + PIN_UNIT[QUEEN] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 10) * 1 * mob
        eg = eg + (cnt - 10) * 2 * mob
        if hit then aw = aw + 80; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac * 0.8; eg = eg + forkVal * 0.5 * tac
        end
    end

    local kf = band(ownK, 15)
    local sh = 0
    for df = -1, 1 do
        local f = kf + df
        if f >= 0 and f <= 7 then
            local sq1 = ownK + fwd + df
            if B[sq1] == pawn then
                sh = sh + 10
            elseif B[sq1 + fwd] == pawn then
                sh = sh + 5
            else
                sh = sh - 12
                if ownFile[f + 2] == 0 then sh = sh - 10 end
            end
        end
    end
    mg = mg + sh * safe
    return mg, eg, aw, an
end

local function dangerOf(aw, an, enemyQueens, att, flight)
    local fm = FLIGHT_MULT[mmin(flight, 8) + 1] / 100
    if an < 2 then
        if an == 1 and flight <= 1 then
            return aw * 0.55 * att * fm
        end
        return 0
    end
    local d = aw * ATK_MULT[mmin(an, 8) + 1] / 100
    if enemyQueens == 0 then d = d * 0.55 end
    return d * att * fm
end

local function developmentTerm(E)
    if E.phase < 12 then return 0 end
    local B = E.board
    local w, b = 0, 0

    if B[1] == KNIGHT then w = w - 10 end
    if B[6] == KNIGHT then w = w - 10 end
    if B[2] == BISHOP then w = w - 9 end
    if B[5] == BISHOP then w = w - 9 end
    if B[113] == -KNIGHT then b = b - 10 end
    if B[118] == -KNIGHT then b = b - 10 end
    if B[114] == -BISHOP then b = b - 9 end
    if B[117] == -BISHOP then b = b - 9 end

    if E.kingW == 2 or E.kingW == 6 then w = w + 14 end
    if E.kingB == 114 or E.kingB == 118 then b = b + 14 end
    return w - b
end

local function evaluate(E)
    local B = E.board
    evalStamp = evalStamp + 1
    local stamp = evalStamp
    for i = 1, 10 do
        fileW[i], fileB[i] = 0, 0
        maxRB[i], minRW[i] = -1, 8
    end
    for t = 1, 6 do CW[t] = 0; CB[t] = 0 end

    for r = 0, 7 do
        local base = r * 16
        for f = 0, 7 do
            local s = base + f
            local p = B[s]
            if p > 0 then
                local n = CW[p] + 1
                CW[p] = n
                LW[p][n] = s
                if p == PAWN then
                    local fi = f + 2
                    fileW[fi] = fileW[fi] + 1
                    if r < minRW[fi] then minRW[fi] = r end
                    pAtkW[s + 15] = stamp; pAtkW[s + 17] = stamp
                end
            elseif p < 0 then
                local t = -p
                local n = CB[t] + 1
                CB[t] = n
                LB[t][n] = s
                if t == PAWN then
                    local fi = f + 2
                    fileB[fi] = fileB[fi] + 1
                    if r > maxRB[fi] then maxRB[fi] = r end
                    pAtkB[s - 15] = stamp; pAtkB[s - 17] = stamp
                end
            end
        end
    end

    local npmW, npmB = E.npmW, E.npmB

    local wk, bk = E.kingW, E.kingB
    zoneW[wk] = stamp
    zoneB[bk] = stamp
    for i = 1, 8 do
        zoneW[wk + KING_D[i]] = stamp
        zoneB[bk + KING_D[i]] = stamp
    end
    for d = -1, 1 do
        zoneW[wk + 32 + d] = stamp
        zoneB[bk - 32 + d] = stamp
    end

    local st = IDENTITY
    local wmg, weg, waw, wan = evalSide(E, B, WHITE, LW, CW, fileW, maxRB, pAtkB, zoneB, stamp, wk, bk, st)
    local bmg, beg, baw, ban = evalSide(E, B, BLACK, LB, CB, fileB, minRW, pAtkW, zoneW, stamp, bk, wk, st)

    local development = developmentTerm(E)
    local mg = E.mg + wmg - bmg + development
    local eg = E.eg + weg - beg + floor(development * 0.35)

    local wkFlight = kingFlightSquares(E, wk, WHITE)
    local bkFlight = kingFlightSquares(E, bk, BLACK)

    local att = st.Att
    local dW = dangerOf(baw, ban, CB[5], att, wkFlight)
    local dB = dangerOf(waw, wan, CW[5], att, bkFlight)
    mg = mg - dW + dB
    eg = eg - dW * 0.25 + dB * 0.25
    mg = mg + (dB - dW) * 0.10

    mg = mg + hangingTerm(E)

    local ph = E.phase
    if ph > 24 then ph = 24 end
    local score = floor((mg * ph + eg * (24 - ph)) / 24)
    score = score + E.side * TEMPO

    -- Distant/direct opposition is a useful but intentionally small signal
    -- in pure king-and-pawn endings; the side not to move holds the tempo.
    if ph <= 2 and (CW[1] + CB[1]) <= 3 then
        local df = abs(band(wk, 15) - band(bk, 15))
        local dr = abs(rshift(wk, 4) - rshift(bk, 4))
        local aligned = df == 0 or dr == 0 or df == dr
        local separation = mmax(df, dr)
        if aligned and separation >= 2 and separation % 2 == 0 then
            score = score - E.side * 8
        end
    end

    if npmW - npmB >= 450 and npmB == 0 and CB[1] == 0 then
        local f, r = band(bk, 15), rshift(bk, 4)
        local cd = mmax(3 - f, f - 4) + mmax(3 - r, r - 4)
        score = score + cd * 10 + (14 - kdist(wk, bk)) * 4
    elseif npmB - npmW >= 450 and npmW == 0 and CW[1] == 0 then
        local f, r = band(wk, 15), rshift(wk, 4)
        local cd = mmax(3 - f, f - 4) + mmax(3 - r, r - 4)
        score = score - (cd * 10 + (14 - kdist(wk, bk)) * 4)
    elseif score > 0 and CW[1] == 0 and npmW - npmB <= 350 then
        score = floor(score / 2)
    elseif score < 0 and CB[1] == 0 and npmB - npmW <= 350 then
        score = -floor(-score / 2)
    end
    return E.side * score
end

local function staticEval(E, alpha, beta)
    local ph = E.phase
    if ph > 24 then ph = 24 end
    local quick = E.side * floor((E.mg * ph + E.eg * (24 - ph)) / 24)
    if quick + LAZY <= alpha or quick - LAZY >= beta then return quick end
    return evaluate(E)
end

local function newTT(bits)
    local size = bit.lshift(1, bits)
    return {
        k1 = table.create(size, -1), k2 = table.create(size, -1),
        mv = table.create(size, 0), dp = table.create(size, 0),
        bd = table.create(size, 0), sc = table.create(size, 0),
        gn = table.create(size, 0),
        mask = size - 1, bits = bits,
    }
end
G.HashBits = mmax(14, mmin(19, floor(tonumber(G.HashBits) or 18)))
G.TT = (G.TT and G.TT.k1 and G.TT.bits == G.HashBits) and G.TT or newTT(G.HashBits)

local function ttStore(E, depth, score, bound, move, ply)
    local tt = E.tt
    local key1, key2 = ttKeys(E)
    local idx = band(key1, tt.mask) + 1
    local same = tt.k1[idx] == key1 and tt.k2[idx] == key2
    local old = tt.dp[idx]
    local replace
    if same then
        replace = depth >= old - 2 or bound == 0
    else
        replace = tt.gn[idx] ~= G.SearchId or depth >= old
    end
    if replace then
        if score > MATE - 1000 then score = score + ply
        elseif score < -MATE + 1000 then score = score - ply end
        if move == 0 and same then move = tt.mv[idx] end
        tt.k1[idx], tt.k2[idx] = key1, key2
        tt.mv[idx], tt.dp[idx], tt.bd[idx], tt.sc[idx], tt.gn[idx] = move, depth, bound, score, G.SearchId
    elseif same and move ~= 0 and tt.mv[idx] == 0 then
        tt.mv[idx] = move
    end
end

local LMRT = {}
for d = 1, 64 do
    LMRT[d] = {}
    for i = 1, 64 do
        LMRT[d][i] = floor(0.7 + mlog(d) * mlog(i) / 2.65)
    end
end

local function touch(E)
    if E.abort then return false end
    if E.cancelled then E.abort = true; return false end

    local n = E.nodes + 1
    E.nodes = n
    if n >= E.nodeLimit then
        E.abort = true
        return false
    end

    local every = E.yieldEvery or 32
    if n % every == 0 then
        -- Cancellation and deadline checks happen at every small batch, not
        -- only after hundreds of nodes. This lets stale searches stop quickly.
        if E.cancel then
            local ok, shouldCancel = pcall(E.cancel)
            if not ok or shouldCancel then
                E.abort = true
                E.cancelled = true
                return false
            end
        end

        local now = clock()
        if now >= E.deadline then
            E.abort = true
            return false
        end

        if E.sliceProvider then
            local ok, dynamicSlice = pcall(E.sliceProvider)
            if ok and type(dynamicSlice) == "number" then
                E.slice = math.clamp(dynamicSlice, 0.001, 0.012)
            end
        end

        local elapsed = now - E.lastYield
        if elapsed > (E.peakSlice or 0) then
            E.peakSlice = elapsed
        end

        if elapsed >= E.slice then
            E.yieldCount = (E.yieldCount or 0) + 1
            yield()
            E.lastYield = clock()
        end
    end

    return true
end

local function drawScore(E, ply)
    local c = IDENTITY.Contempt
    if ply % 2 == 0 then return -c end
    return c
end

local function isRepetition(E)
    if (E.nullSearch or 0) > 0 then return false end
    local n = E.repN
    local lim = E.half
    if lim > n - 1 then lim = n - 1 end
    local stop = n - lim
    local h1, h2 = E.h1, E.h2
    local r1, r2 = E.rep1, E.rep2
    local i, matches = n - 1, 0
    while i >= stop and i >= 1 do
        if r1[i] == h1 and r2[i] == h2 then
            matches = matches + 1
            if matches >= 2 then return true end
        end
        i = i - 1
    end
    return false
end

local function updateHistory(history, k, bonus)
    local h = history[k] or 0
    history[k] = h + bonus - floor(h * abs(bonus) / 16384)
end

local function addHist(E, k, b)
    updateHistory(E.history, k, b)
end

local function addCaptureHist(E, k, b)
    updateHistory(E.captureHistory, k, b)
end

local function pick(moves, scores, i, n)
    local best, bs = i, scores[i]
    for j = i + 1, n do
        if scores[j] > bs then best = j; bs = scores[j] end
    end
    if best ~= i then
        moves[i], moves[best] = moves[best], moves[i]
        scores[i], scores[best] = scores[best], scores[i]
    end
end

local function moveScore(E, m, ply, ttMove)
    if m == ttMove and m ~= 0 then return 9000000 end
    local B = E.board
    local from, to = band(m, 127), band(rshift(m, 7), 127)
    local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
    local piece = B[from]
    local pt = abs(piece)

    if promo ~= 0 then
        local bonus = promo == QUEEN and 1950000 or 1850000
        if band(flags, FLAG_CAPTURE) ~= 0 then
            local victim = band(flags, FLAG_EP) ~= 0 and PAWN or abs(B[to])
            return bonus + VAL[victim] * 10
        end
        return bonus
    end

    if band(flags, FLAG_CAPTURE) ~= 0 then
        local victim = band(flags, FLAG_EP) ~= 0 and PAWN or abs(B[to])
        local exchange = see(E, m)
        local captureKey = (piece + 7) * 128 + to
        local captureBonus = E.captureHistory[captureKey] or 0
        if exchange >= 0 then
            return 2000000 + VAL[victim] * 10 - pt + captureBonus
        end
        return -1000000 + exchange + captureBonus
    end

    local k = E.killers[ply]
    if k then
        if m == k[1] then return 900000 end
        if m == k[2] then return 800000 end
    end
    if ply > 0 then
        local prev = E.stack[ply - 1]
        if prev and prev.piece ~= 0 and E.counter[(prev.piece + 7) * 128 + prev.to] == m then
            return 700000
        end
    end

    local score = E.history[(piece + 7) * 128 + to] or 0
    local file = band(to, 15)
    if file >= 2 and file <= 5 then score = score + IDENTITY.Center end
    local enemyK = E.side == WHITE and E.kingB or E.kingW
    local distance = kdist(to, enemyK)
    if distance <= 3 then score = score + (4 - distance) * 4 end
    return score
end

local insufficientMaterial

local function hasLegalMove(E, ply)
    local moves = generate(E, false)
    for i = 1, #moves do
        local m = moves[i]
        if makeMove(E, m, ply) then
            unmakeMove(E, m, ply)
            return true
        end
    end
    return false
end

local function qsearch(E, alpha, beta, ply, qd)
    if not touch(E) then return 0 end
    E.qnodes = E.qnodes + 1

    local checked = inCheck(E, E.side)
    if insufficientMaterial and insufficientMaterial(E) then return 0 end
    if ply > 0 and (E.half >= 100 or isRepetition(E)) then
        if not hasLegalMove(E, ply) then
            return checked and (-MATE + ply) or 0
        end
        return drawScore(E, ply)
    end

    if ply >= MAX_PLY - 1 then
        if not hasLegalMove(E, ply) then
            return checked and (-MATE + ply) or 0
        end
        return evaluate(E)
    end

    local stand, best
    if checked then
        best = -INF
    else
        stand = staticEval(E, alpha, beta)
        if stand >= beta then
            if not hasLegalMove(E, ply) then return 0 end
            return stand
        end
        if stand > alpha then alpha = stand end
        if qd >= E.maxQDepth then
            if not hasLegalMove(E, ply) then return 0 end
            return stand
        end
        best = stand
    end

    -- Search quiet checking moves briefly, then use captures/promotions only.
    local includeChecks = not checked and qd < 3
    local moves = generate(E, not checked and not includeChecks)
    local n = #moves
    local scores = {}
    local B = E.board

    for i = 1, n do
        local m = moves[i]
        local flags = band(rshift(m, 17), 15)
        local promo = band(rshift(m, 14), 7)
        local sc = 0
        if band(flags, FLAG_CAPTURE) ~= 0 then
            local to = band(rshift(m, 7), 127)
            local victim = (band(flags, FLAG_EP) ~= 0) and PAWN or abs(B[to])
            local attacker = abs(B[band(m, 127)])
            sc = 1000000 + VAL[victim] * 10 - attacker
        elseif promo ~= 0 then
            sc = 900000 + VAL[promo]
        end
        scores[i] = sc
    end

    local legal = 0
    for i = 1, n do
        pick(moves, scores, i, n)
        local m = moves[i]
        local from, to = band(m, 127), band(rshift(m, 7), 127)
        local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
        local isCapture = band(flags, FLAG_CAPTURE) ~= 0
        local pruneCapture = false

        if not checked and isCapture and promo == 0 then
            local victim = (band(flags, FLAG_EP) ~= 0) and PAWN or abs(B[to])
            if stand + VAL[victim] + 340 < alpha then pruneCapture = true end
            if see(E, m) < -120 then pruneCapture = true end
        end

        if makeMove(E, m, ply) then
            local givesCheck = inCheck(E, E.side)
            local include = checked or promo ~= 0
                or (isCapture and (not pruneCapture or givesCheck))
                or (includeChecks and givesCheck)

            if include then
                legal = legal + 1
                local score = -qsearch(E, -beta, -alpha, ply + 1, qd + 1)
                unmakeMove(E, m, ply)
                if E.abort then return 0 end

                if score > best then best = score end
                if score > alpha then
                    alpha = score
                    if alpha >= beta then return score end
                end
            else
                unmakeMove(E, m, ply)
            end
        end
    end

    if checked and legal == 0 then return -MATE + ply end
    -- A quiet-only stalemate can occur at the quiescence horizon.
    if not checked and legal == 0 and not hasLegalMove(E, ply) then return 0 end
    return best
end

insufficientMaterial = function(E)
    -- Major-piece positions cannot be dead material; avoid scanning the board
    -- on the vast majority of search nodes.
    if E.phase > 2 then return false end
    local bishops, knights, minors = 0, 0, 0
    local whiteKnights, blackKnights = 0, 0
    local bishopColor = nil
    for r = 0, 7 do
        for f = 0, 7 do
            local p = E.board[r * 16 + f]
            if p ~= 0 then
                local t = abs(p)
                if t == PAWN or t == ROOK or t == QUEEN then return false end
                if t == BISHOP then
                    bishops = bishops + 1
                    minors = minors + 1
                    local color = (r + f) % 2
                    if bishopColor == nil then bishopColor = color
                    elseif bishopColor ~= color then bishopColor = -1 end
                elseif t == KNIGHT then
                    knights = knights + 1
                    minors = minors + 1
                    if p > 0 then whiteKnights = whiteKnights + 1
                    else blackKnights = blackKnights + 1 end
                end
            end
        end
    end
    if minors <= 1 then return true end
    if bishops == 0 and ((whiteKnights == 2 and blackKnights == 0)
        or (blackKnights == 2 and whiteKnights == 0)) then return true end
    return knights == 0 and bishops > 0 and bishopColor ~= -1
end

local function negamax(E, depth, alpha, beta, ply, allowNull)
    if not touch(E) then return 0 end
    local isPV = beta - alpha > 1
    local checked = inCheck(E, E.side)

    if ply > 0 then
        if insufficientMaterial(E) then return 0 end
        if E.half >= 100 or isRepetition(E) then
            if not hasLegalMove(E, ply) then
                return checked and (-MATE + ply) or 0
            end
            return drawScore(E, ply)
        end
        local a2 = mmax(alpha, -MATE + ply)
        local b2 = mmin(beta, MATE - ply - 1)
        if a2 >= b2 then return a2 end
        alpha, beta = a2, b2
    end
    if ply >= MAX_PLY - 1 then
        if not hasLegalMove(E, ply) then
            return checked and (-MATE + ply) or 0
        end
        return evaluate(E)
    end
    if depth <= 0 then return qsearch(E, alpha, beta, ply, 0) end
    if checked then depth = depth + 1 end

    local alpha0 = alpha
    local nearRoot = ply <= 2

    local tt = E.tt
    local key1, key2 = ttKeys(E)
    local idx = band(key1, tt.mask) + 1
    local ttMove, ttScore, ttDepth, ttBound = 0, 0, -1, 0
    if tt.k1[idx] == key1 and tt.k2[idx] == key2 then
        E.ttHits = (E.ttHits or 0) + 1
        ttMove, ttDepth, ttBound, ttScore = tt.mv[idx], tt.dp[idx], tt.bd[idx], tt.sc[idx]
        if ttScore > MATE - 1000 then ttScore = ttScore - ply
        elseif ttScore < -MATE + 1000 then ttScore = ttScore + ply end
        if not isPV and ttDepth >= depth then
            if ttBound == 0 or (ttBound == 2 and ttScore >= beta) or (ttBound == 1 and ttScore <= alpha) then
                E.ttCutoffs = (E.ttCutoffs or 0) + 1
                return ttScore
            end
        end
    end

    local static = -INF
    if not checked then static = staticEval(E, alpha, beta) end
    E.evalStack[ply] = static
    local improving = false
    if not checked and ply >= 2 then
        local e2 = E.evalStack[ply - 2]
        improving = e2 ~= nil and e2 > -INF and static > e2
    end

    local side = E.side
    if not isPV and not checked and abs(beta) < MATE - 1000 then
        if depth <= 6 and static - 105 * depth + (improving and 0 or 20) >= beta then
            return static
        end
        if depth <= 2 and static + 250 * depth <= alpha then
            local q = qsearch(E, alpha, beta, ply, 0)
            if E.abort then return 0 end
            if q <= alpha then return q end
        end
        local npm = (side == WHITE) and E.npmW or E.npmB
        if allowNull and depth >= 3 and static >= beta and npm >= 900 and E.phase >= 8 then
            local R = 3 + floor(depth / 4) + mmin(2, floor((static - beta) / 200))
            local oldEp, oh1, oh2, ohalf = E.ep, E.h1, E.h2, E.half
            local sN = E.stack[ply]
            if not sN then sN = {}; E.stack[ply] = sN end
            sN.piece, sN.to = 0, 0
            if oldEp >= 0 and epCapturable(E.board, oldEp, side, side == WHITE and E.kingW or E.kingB) then
                local fi = band(oldEp, 15) + 1
                E.h1 = bxor(E.h1, ZE1[fi]); E.h2 = bxor(E.h2, ZE2[fi])
            end
            E.ep = -1
            E.h1 = bxor(E.h1, ZS1); E.h2 = bxor(E.h2, ZS2)
            E.side = -side
            E.half = 0
            E.nullSearch = (E.nullSearch or 0) + 1
            local score = -negamax(E, depth - 1 - R, -beta, -beta + 1, ply + 1, false)
            E.nullSearch = E.nullSearch - 1
            E.side = side
            E.ep = oldEp
            E.h1, E.h2, E.half = oh1, oh2, ohalf
            if E.abort then return 0 end
            if score >= beta then
                if score > MATE - 1000 then score = beta end
                if depth < 9 then return score end
                local v = negamax(E, depth - R, beta - 1, beta, ply, false)
                if E.abort then return 0 end
                if v >= beta then return score end
            end
        end
    end

    if isPV and ttMove == 0 and depth >= 5 then
        negamax(E, depth - 2, alpha, beta, ply, false)
        if E.abort then return 0 end
        if tt.k1[idx] == key1 and tt.k2[idx] == key2 then ttMove = tt.mv[idx] end
    end

    local moves = generate(E, false)
    local n = #moves
    local scores = {}
    for i = 1, n do scores[i] = moveScore(E, moves[i], ply, ttMove) end

    local best, bestMove, legal = -INF, 0, 0
    local quiets, nq = {}, 0
    local B = E.board
    local recaptureSquare = -1
    if ply > 0 then
        local previousState = E.stack[ply - 1]
        if previousState and previousState.captured ~= 0 then
            recaptureSquare = previousState.to
        end
    end
    local lmpBase = nearRoot and 34 or 8

    for i = 1, n do
        pick(moves, scores, i, n)
        local m, sc = moves[i], scores[i]
        local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
        local isCap = band(flags, FLAG_CAPTURE) ~= 0
        local quiet = (not isCap) and promo == 0

        local prune = false
        if not isPV and not checked and best > -MATE + 1000 then
            if quiet then
                if depth <= 3 and nq >= lmpBase + depth * depth then prune = true end
            elseif isCap and sc < -500000 and depth <= 5 and (sc + 1000000) < -90 * depth then
                prune = true
            end
        end

        if not prune and makeMove(E, m, ply) then
            legal = legal + 1
            local skip = false
            if quiet and not isPV and not checked and not nearRoot and depth <= 4 and legal > 1
                and best > -MATE + 1000 and static + 115 + 125 * depth <= alpha and legal > 3 then
                if not inCheck(E, E.side) then skip = true end
            end
            if skip then
                unmakeMove(E, m, ply)
            else
                local extension = 0
                if promo ~= 0 or (isCap and band(rshift(m, 7), 127) == recaptureSquare) then
                    extension = 1
                end
                local newDepth = depth - 1 + extension
                local score
                if legal == 1 then
                    score = -negamax(E, newDepth, -beta, -alpha, ply + 1, true)
                else
                    local r = 0
                    if depth >= 3 and not checked then
                        if quiet and legal > 3 then
                            r = LMRT[mmin(depth, 64)][mmin(legal, 64)]
                            r = floor(r * IDENTITY.LMR + 0.5)
                            if isPV then r = r - 1 end
                            if not improving then r = r + 1 end
                            if sc >= 700000 then r = r - 1
                            elseif sc > -20000 and sc < 20000 then r = r - floor(sc / 5000) end
                        elseif isCap and sc < -500000 and depth >= 5 and legal > 5 then
                            r = 1
                        end
                        if r < 0 then r = 0 end
                        if r > newDepth - 1 then r = mmax(0, newDepth - 1) end
                    end
                    score = -negamax(E, newDepth - r, -alpha - 1, -alpha, ply + 1, true)
                    if score > alpha and r > 0 then
                        score = -negamax(E, newDepth, -alpha - 1, -alpha, ply + 1, true)
                    end
                    if score > alpha and score < beta then
                        score = -negamax(E, newDepth, -beta, -alpha, ply + 1, true)
                    end
                end
                unmakeMove(E, m, ply)
                if E.abort then return 0 end

                if score > best then
                    best = score
                    bestMove = m
                    if score > alpha then
                        alpha = score
                        if alpha >= beta then
                            if isCap then
                                local captureKey = (B[band(m, 127)] + 7) * 128 + band(rshift(m, 7), 127)
                                addCaptureHist(E, captureKey, mmin(1800, depth * depth * 28))
                            end
                            if quiet then
                                local k = E.killers[ply]
                                if not k then k = {0, 0}; E.killers[ply] = k end
                                if k[1] ~= m then k[2] = k[1]; k[1] = m end
                                local bonus = mmin(2000, depth * depth * 32)
                                local pk = (B[band(m, 127)] + 7) * 128 + band(rshift(m, 7), 127)
                                addHist(E, pk, bonus)
                                for q = 1, nq do
                                    local qm = quiets[q]
                                    addHist(E, (B[band(qm, 127)] + 7) * 128 + band(rshift(qm, 7), 127), -bonus)
                                end
                                if ply > 0 then
                                    local prev = E.stack[ply - 1]
                                    if prev and prev.piece ~= 0 then
                                        E.counter[(prev.piece + 7) * 128 + prev.to] = m
                                    end
                                end
                            end
                            break
                        end
                    end
                end
                if quiet then nq = nq + 1; quiets[nq] = m end
            end
        end
    end

    if legal == 0 then
        if checked then return -MATE + ply end
        return 0
    end

    local bound = (best >= beta) and 2 or ((best > alpha0) and 0 or 1)
    ttStore(E, depth, best, bound, bestMove, ply)
    return best
end

local function rootSearch(E, depth, alpha, beta)
    local list = E.root
    local best, bestMove = -INF, 0
    for i = 1, #list do
        local ent = list[i]
        local m = ent.m
        if makeMove(E, m, 0) then
            local newDepth = depth - 1
            local score
            if i == 1 then
                score = -negamax(E, newDepth, -beta, -alpha, 1, true)
            else
                score = -negamax(E, newDepth, -alpha - 1, -alpha, 1, true)
                if score > alpha and score < beta then
                    score = -negamax(E, newDepth, -beta, -alpha, 1, true)
                end
            end
            unmakeMove(E, m, 0)
            if E.abort then return bestMove, best, false end
            ent.score = score
            if score > best then best = score; bestMove = m end
            if score > alpha then alpha = score end
            if alpha >= beta then break end
        end
    end
    return bestMove, best, true
end

local FENP = {P = 1, N = 2, B = 3, R = 4, Q = 5, K = 6, p = -1, n = -2, b = -3, r = -4, q = -5, k = -6}

local function parseFEN(fen)
    local fields = {}
    if type(fen) ~= "string" then return nil end
    for part in string.gmatch(fen, "%S+") do fields[#fields + 1] = part end

    local valid = #fields >= 2
    local placement = fields[1] or ""
    local sideText = fields[2] or "w"
    local side = sideText == "b" and BLACK or WHITE
    if sideText ~= "w" and sideText ~= "b" then valid = false end
    local castleText = fields[3] or "-"
    local epText = fields[4] or "-"
    local half = tonumber(fields[5] or "0") or 0
    if half < 0 then valid = false; half = 0 end

    local B = {}
    for i = 0, 127 do B[i] = 0 end
    local kingW, kingB = -1, -1
    local kingCountW, kingCountB = 0, 0
    local mg, eg, phase, npmW, npmB = 0, 0, 0, 0, 0
    local rank, rowCount = 7, 0

    for row in string.gmatch(placement, "[^/]+") do
        rowCount = rowCount + 1
        local file = 0
        for ch in string.gmatch(row, ".") do
            local num = tonumber(ch)
            if num then
                if num < 1 or num > 8 then valid = false end
                file = file + num
            else
                local piece = FENP[ch]
                if not piece or file >= 8 or rank < 0 then
                    valid = false
                else
                    local sq = rank * 16 + file
                    B[sq] = piece
                    mg = mg + MGT[piece + 7][sq]
                    eg = eg + EGT[piece + 7][sq]
                    local pt = abs(piece)
                    phase = phase + PHASE_W[pt]
                    if pt ~= PAWN and pt ~= KING then
                        if piece > 0 then npmW = npmW + VAL[pt] else npmB = npmB + VAL[pt] end
                    end
                    if piece == KING then kingW = sq; kingCountW = kingCountW + 1 end
                    if piece == -KING then kingB = sq; kingCountB = kingCountB + 1 end
                    file = file + 1
                end
            end
        end
        if file ~= 8 then valid = false end
        rank = rank - 1
    end
    if rowCount ~= 8 or rank ~= -1 or kingCountW ~= 1 or kingCountB ~= 1 then valid = false end

    local castle = 0
    if castleText ~= "-" then
        for ch in string.gmatch(castleText, ".") do
            if ch == "K" then castle = bor(castle, 1)
            elseif ch == "Q" then castle = bor(castle, 2)
            elseif ch == "k" then castle = bor(castle, 4)
            elseif ch == "q" then castle = bor(castle, 8)
            else valid = false end
        end
    end

    local ep = -1
    if epText ~= "-" then
        if #epText == 2 then
            local f = string.byte(epText, 1) - 97
            local r = tonumber(epText:sub(2, 2))
            if f >= 0 and f < 8 and r and r >= 1 and r <= 8 then
                ep = (r - 1) * 16 + f
                local expectedRank = side == BLACK and 2 or 5
                local capturedSq = ep - side * 16
                if r - 1 ~= expectedRank or B[ep] ~= 0 or B[capturedSq] ~= -side * PAWN then valid = false end
            else
                valid = false
            end
        else
            valid = false
        end
    end

    local E = {
        board = B, side = side, castle = castle, ep = ep, half = half,
        mg = mg, eg = eg, phase = phase, npmW = npmW, npmB = npmB,
        kingW = kingW, kingB = kingB, h1 = 0, h2 = 0, valid = valid,
        stack = {}, tt = G.TT, killers = {}, history = {}, captureHistory = G.CaptureHistory, counter = {}, evalStack = {},
        nodes = 0, qnodes = 0, abort = false, maxQDepth = 9, deadline = math.huge,
        nodeLimit = 50000000, lastYield = clock(), slice = 0.03, cancel = nil,
        root = {}, ttHits = 0, ttCutoffs = 0, nullSearch = 0,
    }

    local h1, h2 = 0, 0
    for i = 0, 127 do
        local piece = B[i]
        if piece ~= 0 and ZP1[piece + 7] then
            h1 = bxor(h1, ZP1[piece + 7][i + 1])
            h2 = bxor(h2, ZP2[piece + 7][i + 1])
        end
    end
    h1 = bxor(h1, ZC1[castle + 1]); h2 = bxor(h2, ZC2[castle + 1])
    if ep >= 0 and epCapturable(B, ep, side, side == WHITE and kingW or kingB) then
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    end
    if side == BLACK then h1 = bxor(h1, ZS1); h2 = bxor(h2, ZS2) end
    E.h1, E.h2 = h1, h2
    E.rep1, E.rep2, E.repN = {h1}, {h2}, 1
    return E
end

local FEN_CHAR = {
    [1] = "P", [2] = "N", [3] = "B", [4] = "R", [5] = "Q", [6] = "K",
    [-1] = "p", [-2] = "n", [-3] = "b", [-4] = "r", [-5] = "q", [-6] = "k",
}

local function positionToFEN(E, fullmove)
    local ranks = {}
    for rank = 7, 0, -1 do
        local row, empty = {}, 0
        for file = 0, 7 do
            local piece = E.board[rank * 16 + file]
            if piece == 0 then
                empty = empty + 1
            else
                if empty > 0 then
                    row[#row + 1] = tostring(empty)
                    empty = 0
                end
                row[#row + 1] = FEN_CHAR[piece]
            end
        end
        if empty > 0 then row[#row + 1] = tostring(empty) end
        ranks[#ranks + 1] = table.concat(row)
    end

    local castle = ""
    if band(E.castle, 1) ~= 0 then castle = castle .. "K" end
    if band(E.castle, 2) ~= 0 then castle = castle .. "Q" end
    if band(E.castle, 4) ~= 0 then castle = castle .. "k" end
    if band(E.castle, 8) ~= 0 then castle = castle .. "q" end

    return table.concat({
        table.concat(ranks, "/"),
        E.side == WHITE and "w" or "b",
        castle ~= "" and castle or "-",
        E.ep >= 0 and squareName(E.ep) or "-",
        tostring(E.half or 0),
        tostring(fullmove or 1),
    }, " ")
end

