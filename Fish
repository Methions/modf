-- The decompiled engine precomputes fixed-geometry attacks. Keep that useful
-- idea without importing its unavailable magic-number module or its separate
-- 64-square board representation.
if not G.AttackTables then
    G.AttackTables = {KnightTo = {}, KingTo = {}}
    for s = 0, 127 do
        if ON[s + 64] then
            local kn, kg = {}, {}
            for i = 1, 8 do
                local t = s + KNIGHT_D[i]
                if ON[t + 64] then kn[#kn + 1] = t end
                t = s + KING_D[i]
                if ON[t + 64] then kg[#kg + 1] = t end
            end
            G.AttackTables.KnightTo[s] = kn
            G.AttackTables.KingTo[s] = kg
        end
    end
end

