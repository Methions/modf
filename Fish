-- En-passant belongs in the position key only when at least one capture is
-- actually legal. A pinned pawn or a discovered check after removing both
-- pawns does not make en-passant available for FIDE repetition identity.
local function epCapturable(B, ep, side, kingSq)
    if ep == nil or ep < 0 or kingSq == nil or B[ep] ~= 0 then return false end
    local capSq = ep - side * 16
    if B[capSq] ~= -side * PAWN then return false end
    local from = capSq
    for k = -1, 1, 2 do
        local src = from + k
        if ON[src + 64] and B[src] == side * PAWN then
            local oldSrc, oldCap, oldEp = B[src], B[capSq], B[ep]
            B[src], B[capSq], B[ep] = 0, 0, side * PAWN
            local attacked = isAttacked({board = B}, kingSq, -side)
            B[src], B[capSq], B[ep] = oldSrc, oldCap, oldEp
            if not attacked then return true end
        end
    end
    return false
end

