    local mateFen = "7k/6Q1/6K1/8/8/8/8/8 b - - 0 1"
    local staleFen = "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1"
    local move, score = self:GetBestMoveFromFEN(mateFen, 0.05, {TimeMultiplier = 1, UseBook = false})
    add("Checkmate terminal detection", "nil / -MATE", tostring(move) .. " / " .. tostring(score), move == nil and score == -MATE)
    move, score = self:GetBestMoveFromFEN(staleFen, 0.05, {TimeMultiplier = 1, UseBook = false})
    add("Stalemate terminal detection", "nil / 0", tostring(move) .. " / " .. tostring(score), move == nil and score == 0)

    local deadFen = "7k/8/8/8/8/8/8/5BK1 w - - 0 1"
